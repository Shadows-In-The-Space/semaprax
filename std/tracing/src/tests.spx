module std.tracing.tests;
use function @id("std.tracing.tracestate-field-projection-admitted") from std.tracing as tracestate_field_projection_admitted;
use function @id("std.tracing.byte_is_lower_hex") from std.tracing as byte_is_lower_hex;
use function @id("std.tracing.byte_at_equals") from std.tracing as byte_at_equals;
use function @id("std.tracing.byte_at") from std.tracing as byte_at;
use function @id("std.tracing.hex_run_admitted") from std.tracing as hex_run_admitted;
use function @id("std.tracing.field_is_all_zero") from std.tracing as field_is_all_zero;
use function @id("std.tracing.traceparent_len") from std.tracing as traceparent_len;
use function @id("std.tracing.dash_positions_admitted") from std.tracing as dash_positions_admitted;
use function @id("std.tracing.version_is_forbidden") from std.tracing as version_is_forbidden;
use function @id("std.tracing.version_field_admitted") from std.tracing as version_field_admitted;
use function @id("std.tracing.trace_id_admitted") from std.tracing as trace_id_admitted;
use function @id("std.tracing.parent_id_admitted") from std.tracing as parent_id_admitted;
use function @id("std.tracing.trace_flags_field_admitted") from std.tracing as trace_flags_field_admitted;
use function @id("std.tracing.traceparent_sampled") from std.tracing as traceparent_sampled;
use function @id("std.tracing.traceparent_shape_admitted") from std.tracing as traceparent_shape_admitted;
use function @id("std.tracing.tracestate_member_count_admitted") from std.tracing as tracestate_member_count_admitted;
use function @id("std.tracing.tracestate_combined_length_admitted") from std.tracing as tracestate_combined_length_admitted;
use function @id("std.tracing.slice_equal") from std.tracing as slice_equal;
use function @id("std.tracing.trace_context_fields_admitted") from std.tracing as trace_context_fields_admitted;
use function @id("std.tracing.trace_context_fields_admitted_guarded") from std.tracing as trace_context_fields_admitted_guarded;
use function @id("std.tracing.outbound_traceparent_fields_admitted") from std.tracing as outbound_traceparent_fields_admitted;
use function @id("std.tracing.child_context_admitted") from std.tracing as child_context_admitted;
use function @id("std.tracing.trace_flags_sampled") from std.tracing as trace_flags_sampled;
use function @id("std.tracing.sampling_decision_consistent") from std.tracing as sampling_decision_consistent;
use function @id("std.tracing.tracestate_key_shape_admitted") from std.tracing as tracestate_key_shape_admitted;
use function @id("std.tracing.tracestate_value_shape_admitted") from std.tracing as tracestate_value_shape_admitted;
use function @id("std.tracing.tracestate_member_admitted") from std.tracing as tracestate_member_admitted;
use function @id("std.tracing.tracestate_mutation_admitted") from std.tracing as tracestate_mutation_admitted;

// The trace context's shape and the caller's six secret-bearing
// classifications are independent gates. Every flag is exercised alone so a
// guard that forgets one field cannot hide behind the other five.
@id("std.tracing.tests.trace_context_guarded_refuses_each_secret_flag")
fn trace_context_guarded_refuses_each_secret_flag() -> bool
{
    let trace_id = [97u8; 32];
    let parent_id = [98u8; 16];
    let trace_flags = [48u8, 49u8];
    let trace = array_as_slice(trace_id);
    let parent = array_as_slice(parent_id);
    let flags = array_as_slice(trace_flags);
    let clean = trace_context_fields_admitted_guarded(trace, parent, flags, false, false, false, false, false, false);
    let password = !trace_context_fields_admitted_guarded(trace, parent, flags, true, false, false, false, false, false);
    let api_key = !trace_context_fields_admitted_guarded(trace, parent, flags, false, true, false, false, false, false);
    let bearer_token = !trace_context_fields_admitted_guarded(trace, parent, flags, false, false, true, false, false, false);
    let session_token = !trace_context_fields_admitted_guarded(trace, parent, flags, false, false, false, true, false, false);
    let webhook_secret = !trace_context_fields_admitted_guarded(trace, parent, flags, false, false, false, false, true, false);
    let smtp_credential = !trace_context_fields_admitted_guarded(trace, parent, flags, false, false, false, false, false, true);
    clean && password && api_key && bearer_token && session_token && webhook_secret && smtp_credential
}

// Redaction must not turn a malformed trace context into an admitted one. The
// all-zero trace-id is otherwise the same shape and is refused by the
// unguarded predicate; the guarded form must preserve that refusal with clean
// classification flags as well.
@id("std.tracing.tests.trace_context_guarded_preserves_shape_refusal")
fn trace_context_guarded_preserves_shape_refusal() -> bool
{
    let zero_trace_id = [48u8; 32];
    let parent_id = [98u8; 16];
    let trace_flags = [48u8, 49u8];
    let trace = array_as_slice(zero_trace_id);
    let parent = array_as_slice(parent_id);
    let flags = array_as_slice(trace_flags);
    !trace_context_fields_admitted(trace, parent, flags) && !trace_context_fields_admitted_guarded(trace, parent, flags, false, false, false, false, false, false)
}

// Shared buffer-construction helpers for the cases below. `bytes_zeroed`
// only admits a literal capacity at its own call site (`SPX-T271`), so a
// single length-parameterized filler cannot exist; only the two shapes that
// are each duplicated by more than one case below are worth the cost of a
// named helper (a new call site costs the same order as a declaration, so
// factoring out a body used only once is a net loss, not a win).
//
// `zero_ascii_range` consumes the one live `Bytes` buffer and returns it,
// matching the loop-carried fill shape (`buffer = bytes_set(buffer, ...)`)
// each case already used inline; a caller cannot reassign its own binding
// through this call (`SPX-U105`: explicit mutation only republishes a
// binding through a direct `bytes_zeroed`/`bytes_set` chain, never through
// another function), so every call site below binds the result to a fresh
// name instead.
@id("std.tracing.tests.zero_ascii_range")
fn zero_ascii_range(source: own Bytes, start: usize, end: usize) -> Bytes
{
    let mut buffer = source;
    let mut index = start;
    while index < end {
        buffer = bytes_set(buffer, index, 48u8);
        index = index + 1usize;
        index < end
    }
    buffer
}

// A well-formed 55-byte `traceparent`: filler `a` bytes, version `00`, the
// three dashes in place, and trace-flags `0<last_flag_digit>`. Shared by
// every case that needs a header admitted before it mutates one field.
@id("std.tracing.tests.header_with_sampled_bit")
fn header_with_sampled_bit(last_flag_digit: u8) -> Bytes
{
    let mut header = bytes_zeroed(55usize);
    let mut fill_index = 0usize;
    while fill_index < 55usize {
        header = bytes_set(header, fill_index, 97u8);
        fill_index = fill_index + 1usize;
        fill_index < 55usize
    }
    header = bytes_set(header, 0usize, 48u8);
    header = bytes_set(header, 1usize, 48u8);
    header = bytes_set(header, 2usize, 45u8);
    header = bytes_set(header, 35usize, 45u8);
    header = bytes_set(header, 52usize, 45u8);
    header = bytes_set(header, 53usize, 48u8);
    header = bytes_set(header, 54usize, last_flag_digit);
    header
}

// The hex alphabet boundary bytes, asserted at the predicate the scanners
// are built from rather than only through them. An uppercase hex digit is a
// well-formed hex character in general but is refused here.
@id("std.tracing.tests.hex_alphabet_boundaries")
fn hex_alphabet_boundaries() -> bool
{
    byte_is_lower_hex(48u8) && byte_is_lower_hex(57u8) && byte_is_lower_hex(97u8) && byte_is_lower_hex(102u8) && !byte_is_lower_hex(47u8) && !byte_is_lower_hex(58u8) && !byte_is_lower_hex(96u8) && !byte_is_lower_hex(103u8) && !byte_is_lower_hex(65u8)
}

@id("std.tracing.tests.traceparent_len_is_fifty_five")
fn traceparent_len_is_fifty_five() -> bool
{
    traceparent_len() == 55usize
}

// `byte_at_equals` and `byte_at` agree in range and each degrade safely
// out of range, rather than one of them reading past the buffer.
@id("std.tracing.tests.byte_accessors_agree")
fn byte_accessors_agree() -> bool
{
    let mut probe = bytes_zeroed(2usize);
    probe = bytes_set(probe, 0usize, 45u8);
    probe = bytes_set(probe, 1usize, 97u8);
    let in_range_match = byte_at_equals(bytes_as_slice(probe), 0usize, 45u8);
    let in_range_mismatch = !byte_at_equals(bytes_as_slice(probe), 0usize, 97u8);
    let out_of_range_refused = !byte_at_equals(bytes_as_slice(probe), 5usize, 45u8);
    let value_read = byte_at(bytes_as_slice(probe), 1usize) == 97u8;
    let out_of_range_defaults_zero = byte_at(bytes_as_slice(probe), 5usize) == 0u8;
    in_range_match && in_range_mismatch && out_of_range_refused && value_read && out_of_range_defaults_zero
}

// A run that fits and is all lowercase hex is admitted; a run whose length
// runs past the buffer is refused without reading anything, and a single
// uppercase byte anywhere in the run refuses the whole run.
@id("std.tracing.tests.hex_run_boundaries")
fn hex_run_boundaries() -> bool
{
    let mut run = bytes_zeroed(3usize);
    run = bytes_set(run, 0usize, 97u8);
    run = bytes_set(run, 1usize, 98u8);
    run = bytes_set(run, 2usize, 99u8);
    let admitted = hex_run_admitted(bytes_as_slice(run), 0usize, 3usize);
    let past_end_refused = !hex_run_admitted(bytes_as_slice(run), 1usize, 5usize);
    run = bytes_set(run, 2usize, 71u8);
    let uppercase_refused = !hex_run_admitted(bytes_as_slice(run), 0usize, 3usize);
    admitted && past_end_refused && uppercase_refused
}

// All-zero is detected exactly, one non-zero byte anywhere refuses it, and a
// range past the buffer end is refused rather than read.
@id("std.tracing.tests.all_zero_field_boundaries")
fn all_zero_field_boundaries() -> bool
{
    let mut field = bytes_zeroed(4usize);
    field = bytes_set(field, 0usize, 48u8);
    field = bytes_set(field, 1usize, 48u8);
    field = bytes_set(field, 2usize, 48u8);
    field = bytes_set(field, 3usize, 48u8);
    let all_zero = field_is_all_zero(bytes_as_slice(field), 0usize, 4usize);
    let past_end_refused = !field_is_all_zero(bytes_as_slice(field), 1usize, 10usize);
    field = bytes_set(field, 3usize, 49u8);
    let one_nonzero_refused = !field_is_all_zero(bytes_as_slice(field), 0usize, 4usize);
    all_zero && past_end_refused && one_nonzero_refused
}

// `00` is admitted, `ff` is forbidden outright, and a non-hex version byte
// is refused by the hex-run clause before the forbidden-value clause even
// matters.
@id("std.tracing.tests.version_field_cases")
fn version_field_cases() -> bool
{
    let mut version = bytes_zeroed(2usize);
    version = bytes_set(version, 0usize, 48u8);
    version = bytes_set(version, 1usize, 48u8);
    let zero_admitted = version_field_admitted(bytes_as_slice(version)) && !version_is_forbidden(bytes_as_slice(version));
    version = bytes_set(version, 0usize, 102u8);
    version = bytes_set(version, 1usize, 102u8);
    let ff_forbidden = version_is_forbidden(bytes_as_slice(version)) && !version_field_admitted(bytes_as_slice(version));
    version = bytes_set(version, 0usize, 48u8);
    version = bytes_set(version, 1usize, 71u8);
    let non_hex_refused = !version_field_admitted(bytes_as_slice(version));
    zero_admitted && ff_forbidden && non_hex_refused
}

// All three dash positions are checked individually: a header wrong at only
// the middle dash is refused exactly as one wrong at either outer dash.
@id("std.tracing.tests.dash_positions_cases")
fn dash_positions_cases() -> bool
{
    let mut header = header_with_sampled_bit(49u8);
    let admitted = dash_positions_admitted(bytes_as_slice(header));
    header = bytes_set(header, 35usize, 97u8);
    let middle_dash_wrong_refused = !dash_positions_admitted(bytes_as_slice(header));
    admitted && middle_dash_wrong_refused
}

// The all-zero trace-id refusal, asserted on its own: a trace-id of all `a`
// is admitted, and the same field zeroed out is refused even though it is
// still perfectly well-formed hex.
@id("std.tracing.tests.trace_id_all_zero_refused")
fn trace_id_all_zero_refused() -> bool
{
    let mut field = bytes_zeroed(35usize);
    let mut index = 0usize;
    while index < 35usize {
        field = bytes_set(field, index, 97u8);
        index = index + 1usize;
        index < 35usize
    }
    let nonzero_admitted = trace_id_admitted(bytes_as_slice(field));
    let zeroed = zero_ascii_range(field, 3usize, 35usize);
    let all_zero_refused = !trace_id_admitted(bytes_as_slice(zeroed));
    nonzero_admitted && all_zero_refused
}

// The all-zero parent-id refusal, split from the trace-id case above rather
// than sharing its buffer: this package's conformance module is declared
// arena-bounded, so at most one `Bytes` value may be live at a time.
@id("std.tracing.tests.parent_id_all_zero_refused")
fn parent_id_all_zero_refused() -> bool
{
    let mut field = bytes_zeroed(52usize);
    let mut index = 0usize;
    while index < 52usize {
        field = bytes_set(field, index, 98u8);
        index = index + 1usize;
        index < 52usize
    }
    let nonzero_admitted = parent_id_admitted(bytes_as_slice(field));
    let zeroed = zero_ascii_range(field, 36usize, 52usize);
    let all_zero_refused = !parent_id_admitted(bytes_as_slice(zeroed));
    nonzero_admitted && all_zero_refused
}

// Every trace-flags byte value is admitted so long as it is two lowercase
// hex digits; only the hex shape is checked here, never a value range.
@id("std.tracing.tests.trace_flags_field_cases")
fn trace_flags_field_cases() -> bool
{
    let mut field = bytes_zeroed(55usize);
    field = bytes_set(field, 53usize, 102u8);
    field = bytes_set(field, 54usize, 102u8);
    let admitted = trace_flags_field_admitted(bytes_as_slice(field));
    field = bytes_set(field, 54usize, 71u8);
    let non_hex_refused = !trace_flags_field_admitted(bytes_as_slice(field));
    admitted && non_hex_refused
}

// The sampled bit is read from the final hex digit alone: flipping only the
// last character between `1` and `0` flips the result, with the rest of the
// header untouched and still well-formed.
@id("std.tracing.tests.sampled_bit_extraction")
fn sampled_bit_extraction() -> bool
{
    let mut header = header_with_sampled_bit(49u8);
    let shape_holds = traceparent_shape_admitted(bytes_as_slice(header));
    let sampled = traceparent_sampled(bytes_as_slice(header));
    header = bytes_set(header, 54usize, 48u8);
    let unsampled = !traceparent_sampled(bytes_as_slice(header));
    let shape_still_holds = traceparent_shape_admitted(bytes_as_slice(header));
    shape_holds && sampled && unsampled && shape_still_holds
}

// A header of any other length is refused outright, independent of every
// other field being well-formed. Split into its own function so this probe
// never coexists with another package-conformance buffer.
@id("std.tracing.tests.wrong_length_refused")
fn wrong_length_refused() -> bool
{
    let header = header_with_sampled_bit(49u8);
    let header_view = bytes_as_slice(header);
    let short = byte_range(header_view, 0usize, 54usize);
    !traceparent_shape_admitted(short)
}

// The `tracestate` budgets are inclusive at their ceiling and refuse one
// unit past it.
@id("std.tracing.tests.tracestate_budget_boundaries")
fn tracestate_budget_boundaries() -> bool
{
    let member_zero_ok = tracestate_member_count_admitted(0usize);
    let member_ceiling_ok = tracestate_member_count_admitted(32usize);
    let member_over_refused = !tracestate_member_count_admitted(33usize);
    let length_zero_ok = tracestate_combined_length_admitted(0usize);
    let length_ceiling_ok = tracestate_combined_length_admitted(512usize);
    let length_over_refused = !tracestate_combined_length_admitted(513usize);
    member_zero_ok && member_ceiling_ok && member_over_refused && length_zero_ok && length_ceiling_ok && length_over_refused
}

// `slice_equal` agrees at every index, refuses on a length mismatch, and
// refuses when the two views differ only at their final byte — the same
// "stops one byte early" failure shape this repository has hit before. Each
// array is borrowed once into a view and the view reused, rather than
// re-borrowing the same array at every call site.
@id("std.tracing.tests.slice_equal_cases")
fn slice_equal_cases() -> bool
{
    let left = [97u8, 98u8, 99u8];
    let same = [97u8, 98u8, 99u8];
    let differs_at_end = [97u8, 98u8, 100u8];
    let shorter = [97u8, 98u8];
    let left_view = array_as_slice(left);
    slice_equal(left_view, array_as_slice(same)) && !slice_equal(left_view, array_as_slice(differs_at_end)) && !slice_equal(left_view, array_as_slice(shorter))
}

// The outbound mirror of the inbound all-zero refusal: a well-formed
// version/trace-id/parent-id/trace-flags quadruple is admitted; the
// forbidden `ff` version, an all-zero trace-id, and an all-zero parent-id
// are each refused individually. The all-zero cases are the exact asymmetry
// this package's own review called out: an outbound path that admitted what
// the inbound path refuses would be a real bug, not a stylistic gap.
@id("std.tracing.tests.outbound_traceparent_fields_admitted_cases")
fn outbound_traceparent_fields_admitted_cases() -> bool
{
    let version = [48u8, 48u8];
    let forbidden_version = [102u8, 102u8];
    let trace_id = [97u8; 32];
    let parent_id = [98u8; 16];
    let flags = [48u8, 49u8];
    let zero_trace_id = [48u8; 32];
    let zero_parent_id = [48u8; 16];
    let version_view = array_as_slice(version);
    let trace_id_view = array_as_slice(trace_id);
    let parent_id_view = array_as_slice(parent_id);
    let flags_view = array_as_slice(flags);
    let admitted = outbound_traceparent_fields_admitted(version_view, trace_id_view, parent_id_view, flags_view);
    let context_fields_admitted = trace_context_fields_admitted(trace_id_view, parent_id_view, flags_view);
    let forbidden_version_refused = !outbound_traceparent_fields_admitted(array_as_slice(forbidden_version), trace_id_view, parent_id_view, flags_view);
    let zero_trace_refused = !outbound_traceparent_fields_admitted(version_view, array_as_slice(zero_trace_id), parent_id_view, flags_view);
    let zero_parent_refused = !outbound_traceparent_fields_admitted(version_view, trace_id_view, array_as_slice(zero_parent_id), flags_view);
    admitted && context_fields_admitted && forbidden_version_refused && zero_trace_refused && zero_parent_refused
}

// A child sharing its parent's trace-id, carrying a distinct span-id, and
// inheriting the parent's flags is admitted. A different trace-id, an
// unchanged (self-loop) span-id, and a changed flags byte are each refused
// individually, so a regression in any one consistency clause fails here
// rather than hiding behind the others.
@id("std.tracing.tests.child_context_admitted_cases")
fn child_context_admitted_cases() -> bool
{
    let parent_trace_id = [97u8; 32];
    let parent_span_id = [98u8; 16];
    let parent_flags = [48u8, 49u8];
    let child_span_id = [99u8; 16];
    let other_trace_id = [100u8; 32];
    let different_flags = [48u8, 48u8];
    let parent_trace_id_view = array_as_slice(parent_trace_id);
    let parent_span_id_view = array_as_slice(parent_span_id);
    let parent_flags_view = array_as_slice(parent_flags);
    let child_span_id_view = array_as_slice(child_span_id);
    let consistent = child_context_admitted(parent_trace_id_view, parent_span_id_view, parent_flags_view, parent_trace_id_view, child_span_id_view, parent_flags_view);
    let trace_mismatch_refused = !child_context_admitted(parent_trace_id_view, parent_span_id_view, parent_flags_view, array_as_slice(other_trace_id), child_span_id_view, parent_flags_view);
    let self_loop_refused = !child_context_admitted(parent_trace_id_view, parent_span_id_view, parent_flags_view, parent_trace_id_view, parent_span_id_view, parent_flags_view);
    let flags_mismatch_refused = !child_context_admitted(parent_trace_id_view, parent_span_id_view, parent_flags_view, parent_trace_id_view, child_span_id_view, array_as_slice(different_flags));
    consistent && trace_mismatch_refused && self_loop_refused && flags_mismatch_refused
}

// The sampled bit reads off the final hex digit of a standalone flags field
// exactly as it does embedded in a header. Consistency: unsampled-to-sampled
// (an upgrade) is consistent, but sampled-to-unsampled (a downgrade) is
// refused.
@id("std.tracing.tests.sampling_decision_cases")
fn sampling_decision_cases() -> bool
{
    let sampled = [48u8, 49u8];
    let unsampled = [48u8, 48u8];
    let sampled_view = array_as_slice(sampled);
    let unsampled_view = array_as_slice(unsampled);
    let reads_sampled = trace_flags_sampled(sampled_view);
    let reads_unsampled = !trace_flags_sampled(unsampled_view);
    let upgrade_ok = sampling_decision_consistent(unsampled_view, sampled_view);
    let downgrade_refused = !sampling_decision_consistent(sampled_view, unsampled_view);
    reads_sampled && reads_unsampled && upgrade_ok && downgrade_refused
}

// A simple-key of letters, digits, dash and underscore is admitted; a
// digit-first key, an invalid tail byte in the final position, and one byte
// past the 256-byte ceiling are each refused, with the ceiling itself
// admitted at exactly 256.
@id("std.tracing.tests.tracestate_key_shape_cases")
fn tracestate_key_shape_cases() -> bool
{
    let simple = [97u8, 98u8, 45u8, 95u8];
    let digit_first = [49u8, 97u8, 98u8];
    let bad_final = [97u8, 97u8, 35u8];
    let max_len = [97u8; 256];
    let over_max = [97u8; 257];
    let admitted = tracestate_key_shape_admitted(array_as_slice(simple));
    let digit_first_refused = !tracestate_key_shape_admitted(array_as_slice(digit_first));
    let final_refused = !tracestate_key_shape_admitted(array_as_slice(bad_final));
    let max_admitted = tracestate_key_shape_admitted(array_as_slice(max_len));
    let over_max_refused = !tracestate_key_shape_admitted(array_as_slice(over_max));
    admitted && digit_first_refused && final_refused && max_admitted && over_max_refused
}

// A value may carry interior whitespace but not trailing whitespace; a
// forbidden delimiter byte (`,`) refuses the value even in the final
// position, where a scan that stopped one byte early would miss it; the
// 256-byte ceiling is admitted exactly at 256 and refused one byte past it.
@id("std.tracing.tests.tracestate_value_shape_cases")
fn tracestate_value_shape_cases() -> bool
{
    let interior_space = [97u8, 32u8, 98u8];
    let trailing_space = [97u8, 98u8, 32u8];
    let comma_final = [97u8, 98u8, 44u8];
    let max_len = [97u8; 256];
    let over_max = [97u8; 257];
    let admitted = tracestate_value_shape_admitted(array_as_slice(interior_space));
    let trailing_space_refused = !tracestate_value_shape_admitted(array_as_slice(trailing_space));
    let comma_final_refused = !tracestate_value_shape_admitted(array_as_slice(comma_final));
    let max_admitted = tracestate_value_shape_admitted(array_as_slice(max_len));
    let over_max_refused = !tracestate_value_shape_admitted(array_as_slice(over_max));
    admitted && trailing_space_refused && comma_final_refused && max_admitted && over_max_refused
}

// The composed member judgement: a well-formed `key=value` is admitted; no
// `=`, two `=` bytes, an invalid key, and an invalid value are each refused.
@id("std.tracing.tests.tracestate_member_admitted_cases")
fn tracestate_member_admitted_cases() -> bool
{
    let valid = [118u8, 101u8, 110u8, 100u8, 111u8, 114u8, 61u8, 49u8];
    let no_equals = [118u8, 101u8, 110u8, 100u8, 111u8, 114u8];
    let two_equals = [97u8, 61u8, 98u8, 61u8, 99u8];
    let bad_key = [49u8, 61u8, 98u8];
    let bad_value = [97u8, 61u8, 32u8];
    let admitted = tracestate_member_admitted(array_as_slice(valid));
    let no_equals_refused = !tracestate_member_admitted(array_as_slice(no_equals));
    let two_equals_refused = !tracestate_member_admitted(array_as_slice(two_equals));
    let bad_key_refused = !tracestate_member_admitted(array_as_slice(bad_key));
    let bad_value_refused = !tracestate_member_admitted(array_as_slice(bad_value));
    admitted && no_equals_refused && two_equals_refused && bad_key_refused && bad_value_refused
}

// A mutated key that both leads the list and has no sibling duplicate is
// admitted; the same key not in front, and the same key duplicated at a
// sibling, are each refused.
@id("std.tracing.tests.tracestate_mutation_admitted_cases")
fn tracestate_mutation_admitted_cases() -> bool
{
    let mutated = [118u8, 101u8, 110u8, 100u8, 111u8, 114u8];
    let different_first = [111u8, 116u8, 104u8, 101u8, 114u8];
    let duplicate_sibling = [118u8, 101u8, 110u8, 100u8, 111u8, 114u8];
    let mutated_view = array_as_slice(mutated);
    let sibling_view = array_as_slice(different_first);
    let admitted = tracestate_mutation_admitted(mutated_view, mutated_view, sibling_view);
    let not_first_refused = !tracestate_mutation_admitted(mutated_view, array_as_slice(different_first), sibling_view);
    let duplicate_refused = !tracestate_mutation_admitted(mutated_view, mutated_view, array_as_slice(duplicate_sibling));
    admitted && not_first_refused && duplicate_refused
}

// The original inbound-admission conformance sum, unchanged. Split from the
// outbound/propagation sum below (and combined only through arithmetic in
// `main`, never through another `if`) because `main`'s single flat sequence
// of independent `if`/`else` sums multiplies its terminal control-flow paths
// combinatorially (`2^N` in the number of such expressions) rather than
// adding by branch count, and the combined sequence exceeded the
// cleanup-replay skeleton-work budget (SPX-H006).
@id("std.tracing.tests.inbound_conformance_failures")
fn inbound_conformance_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if hex_alphabet_boundaries() { 0 } else { 1 };
    failed = failed + if traceparent_len_is_fifty_five() { 0 } else { 2 };
    failed = failed + if byte_accessors_agree() { 0 } else { 4 };
    failed = failed + if hex_run_boundaries() { 0 } else { 8 };
    failed = failed + if all_zero_field_boundaries() { 0 } else { 16 };
    failed = failed + if version_field_cases() { 0 } else { 32 };
    failed = failed + if dash_positions_cases() { 0 } else { 64 };
    failed = failed + if trace_id_all_zero_refused() { 0 } else { 128 };
    failed = failed + if parent_id_all_zero_refused() { 0 } else { 256 };
    failed = failed + if trace_flags_field_cases() { 0 } else { 512 };
    failed = failed + if sampled_bit_extraction() { 0 } else { 1024 };
    failed = failed + if wrong_length_refused() { 0 } else { 2048 };
    failed = failed + if tracestate_budget_boundaries() { 0 } else { 4096 };
    failed
}

// The outbound/propagation conformance sum (issue #193's span-identity and
// propagation additions), kept in its own bit range (`* 8192`) so a failure
// here is never mistaken for one of the pre-existing inbound codes above.
@id("std.tracing.tests.outbound_conformance_failures")
fn outbound_conformance_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if slice_equal_cases() { 0 } else { 1 };
    failed = failed + if outbound_traceparent_fields_admitted_cases() { 0 } else { 2 };
    failed = failed + if child_context_admitted_cases() { 0 } else { 4 };
    failed = failed + if sampling_decision_cases() { 0 } else { 8 };
    failed = failed + if tracestate_key_shape_cases() { 0 } else { 16 };
    failed = failed + if tracestate_value_shape_cases() { 0 } else { 32 };
    failed = failed + if tracestate_member_admitted_cases() { 0 } else { 64 };
    failed = failed + if tracestate_mutation_admitted_cases() { 0 } else { 128 };
    failed
}

// The redaction-guard conformance sum uses its own bit range so a failure in
// the policy wrapper cannot be confused with the shape/propagation cases.
@id("std.tracing.tests.redaction_guard_failures")
fn redaction_guard_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if trace_context_guarded_refuses_each_secret_flag() { 0 } else { 1 };
    failed = failed + if trace_context_guarded_preserves_shape_refusal() { 0 } else { 2 };
    failed
}

@id("std.tracing.tests.main")
fn main() -> i64
{
    inbound_conformance_failures() + outbound_conformance_failures() * 8192 + redaction_guard_failures() * 16384 + projection_policy_failures()
}

@id("std.tracing.tests.projection-policy-cases")
fn projection_policy_cases() -> bool
{
    let protected = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let public = [102u8, 105u8, 101u8, 108u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let suffixed = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8, 120u8];
    let injection = [102u8, 10u8];
    let invalid_commitment = [103u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refuses_named = !tracestate_field_projection_admitted(array_as_slice(protected), false, array_as_slice(raw), absent);
    let refuses_classified = !tracestate_field_projection_admitted(array_as_slice(public), true, array_as_slice(raw), absent);
    let admits_named_marker = tracestate_field_projection_admitted(array_as_slice(protected), false, array_as_slice(marker), absent);
    let admits_value_marker = tracestate_field_projection_admitted(array_as_slice(public), true, array_as_slice(marker), absent);
    let refuses_suffix = !tracestate_field_projection_admitted(array_as_slice(protected), true, array_as_slice(suffixed), absent);
    let admits_public = tracestate_field_projection_admitted(array_as_slice(public), false, array_as_slice(raw), absent);
    let refuses_injection = !tracestate_field_projection_admitted(array_as_slice(injection), false, array_as_slice(raw), absent);
    let refuses_commitment = !tracestate_field_projection_admitted(array_as_slice(protected), true, array_as_slice(marker), array_as_slice(invalid_commitment));
    refuses_named && refuses_classified && admits_named_marker && admits_value_marker && refuses_suffix && admits_public && refuses_injection && refuses_commitment
}

@id("std.tracing.tests.projection-value-limit")
fn projection_value_limit() -> bool
{
    let name = [102u8, 105u8, 101u8, 108u8, 100u8];
    let mut value = bytes_zeroed(257usize);
    let mut index = 0usize;
    while index < 257usize {
        value = bytes_set(value, index, 97u8);
        index = index + 1usize;
        index < 257usize
    }
    let view = bytes_as_slice(value);
    let absent = byte_range(view, 0usize, 0usize);
    let at_limit = tracestate_field_projection_admitted(array_as_slice(name), false, byte_range(view, 0usize, 256usize), absent);
    let above_limit = !tracestate_field_projection_admitted(array_as_slice(name), false, view, absent);
    at_limit && above_limit
}

@id("std.tracing.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if projection_policy_cases() && projection_value_limit() { 0 } else { 1073741824 }
}
