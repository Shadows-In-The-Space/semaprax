module std.log.tests;
use function @id("std.log.redact.projection-len-admitted") from std.log.redact as projection_len_admitted;
use function @id("std.log.field-projection-admitted") from std.log as field_projection_admitted;
use type @id("std.log.event") from std.log as Event;
use type @id("std.io.writer") from std.io as Writer;
use function @id("std.log.append-event") from std.log as append_event;
use function @id("std.log.append-event-guarded") from std.log as append_event_guarded;
use function @id("std.log.append-event-if") from std.log as append_event_if;
use function @id("std.log.discard-event") from std.log as discard_event;
use function @id("std.log.event-admitted") from std.log as event_admitted;
use function @id("std.log.level-enabled") from std.log as level_enabled;
use function @id("std.log.event-json-len") from std.log as event_json_len;
use function @id("std.log.fixed-byte") from std.log as fixed_byte;
use function @id("std.log.fixed-len") from std.log as fixed_len;
use function @id("std.log.level-byte") from std.log as level_byte;
use function @id("std.log.level-len") from std.log as level_len;
use function @id("std.log.quote-bytes") from std.log as quote_bytes;
use function @id("std.log.write-fixed") from std.log as write_fixed;
use function @id("std.log.write-level") from std.log as write_level;
use function @id("std.io.writer.cursor") from std.io as writer_position;
use function @id("std.io.writer.finish") from std.io as writer_finish;
use function @id("std.io.writer.from-bytes") from std.io as writer_from_bytes;

@id("std.log.tests.equal")
fn equal(left: borrow Slice<u8>, right: borrow Slice<u8>) -> bool
{
    let mut index = 0usize;
    let mut same = byte_len(left) == byte_len(right);
    while same && index < byte_len(left) {
        let a = match byte_get(left, index) { Option::Some { value } => value, Option::None {} => 0u8, };
        let b = match byte_get(right, index) { Option::Some { value } => value, Option::None {} => 0u8, };
        same = a == b;
        index = index + 1usize;
        same
    }
    same
}

@id("std.log.tests.test-line")
fn test_line() -> i64
{
    let name = [97u8, 34u8];
    let message = [10u8];
    let event = Event { level: 2u8, sequence: 7usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = append_event(event, writer_from_bytes(bytes_zeroed(64usize)));
    let position = writer_position(output);
    let bytes = writer_finish(output);
    let expected = [123u8, 34u8, 108u8, 101u8, 118u8, 101u8, 108u8, 34u8, 58u8, 34u8, 105u8, 110u8, 102u8, 111u8, 34u8, 44u8, 34u8, 115u8, 101u8, 113u8, 117u8, 101u8, 110u8, 99u8, 101u8, 34u8, 58u8, 55u8, 44u8, 34u8, 101u8, 118u8, 101u8, 110u8, 116u8, 34u8, 58u8, 34u8, 97u8, 92u8, 34u8, 34u8, 44u8, 34u8, 109u8, 101u8, 115u8, 115u8, 97u8, 103u8, 101u8, 34u8, 58u8, 34u8, 92u8, 110u8, 34u8, 125u8, 10u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    if position == 59usize && equal(bytes_as_slice(bytes), array_as_slice(expected)) { 0 } else { 1 }
}

@id("std.log.tests.test-filtered")
fn test_filtered() -> i64
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 1u8, sequence: 3usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_if(event, 4u8, output);
    let position = writer_position(written);
    let bytes = writer_finish(written);
    let head = match byte_get(bytes_as_slice(bytes), 0usize) { Option::Some { value } => value, Option::None {} => 1u8, };
    if position == 0usize && head == 0u8 && byte_len(bytes_as_slice(bytes)) == 64usize { 0 } else { 1 }
}

// ---------------------------------------------------------------------
// Redaction guard (issue #193)
// ---------------------------------------------------------------------
// `append-event-guarded` was declared but never exercised by any test in
// this package until this tranche: `use function` imported it (above) and
// nothing ever called it. Pinned here: the safe path writes through exactly
// like the unguarded `append_event`, and a secret-bearing flag discards the
// WHOLE event rather than writing it -- the writer comes back at the
// position it started at, none of the event's bytes appended. This is a
// REFUSAL, not the "visible redacted marker" step 2 also asks for: this
// package's `Event` has no separate labeled-field structure to redact one
// field of (see `append-event-guarded`'s own doc comment in `log.spx`), so
// `std.log.redact.marker_byte`'s fixed marker is never written by this
// function -- discarding the event is a real, sound mitigation, but it does
// not by itself satisfy step 2's marker requirement.
//
// One representative secret-bearing flag is enough to pin the writer-level
// behaviour here: `std.log.redact.tests.event_safety` already exhaustively
// asserts, at the pure decision layer, that EACH of the six flags on its own
// (and combinations) makes `event_is_safe` false. Asserting all six again
// through this writer, each with its own freshly-built `Event` (two
// `bytes_copy` sites apiece), would add no coverage `event_safety` does not
// already give while multiplying this package's bytes-copy call-path budget
// (`SPX-T267`) -- which this tranche found is shared, non-additively, with
// `append-event-if`'s own reachable path once both are exercised from the
// same entry point.
@id("std.log.tests.guarded-writes-through-when-safe")
fn guarded_writes_through_when_safe() -> bool
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 2u8, sequence: 1usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_guarded(event, false, false, false, false, false, false, output);
    writer_position(written) > 0usize
}

@id("std.log.tests.guarded-discards-when-unsafe")
fn guarded_discards_when_unsafe() -> bool
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 2u8, sequence: 1usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_guarded(event, true, false, false, false, false, false, output);
    writer_position(written) == 0usize
}

@id("std.log.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if test_line() == 0 { 0 } else { 1 };
    failed = failed + if guarded_writes_through_when_safe() { 0 } else { 2 };
    failed = failed + if guarded_discards_when_unsafe() { 0 } else { 4 };
    failed + projection_policy_failures()
}

@id("std.log.tests.projection-policy-cases")
fn projection_policy_cases() -> bool
{
    let protected = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let public = [102u8, 105u8, 101u8, 108u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let suffixed = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8, 120u8];
    let injection = [102u8, 10u8];
    let invalid_commitment = [103u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refuses_named = !field_projection_admitted(array_as_slice(protected), false, array_as_slice(raw), absent);
    let refuses_classified = !field_projection_admitted(array_as_slice(public), true, array_as_slice(raw), absent);
    let admits_named_marker = field_projection_admitted(array_as_slice(protected), false, array_as_slice(marker), absent);
    let admits_value_marker = field_projection_admitted(array_as_slice(public), true, array_as_slice(marker), absent);
    let refuses_suffix = !field_projection_admitted(array_as_slice(protected), true, array_as_slice(suffixed), absent);
    let admits_public = field_projection_admitted(array_as_slice(public), false, array_as_slice(raw), absent);
    let refuses_injection = !field_projection_admitted(array_as_slice(injection), false, array_as_slice(raw), absent);
    let refuses_commitment = !field_projection_admitted(array_as_slice(protected), true, array_as_slice(marker), array_as_slice(invalid_commitment));
    refuses_named && refuses_classified && admits_named_marker && admits_value_marker && refuses_suffix && admits_public && refuses_injection && refuses_commitment
}

@id("std.log.tests.projection-value-limit")
fn projection_value_limit() -> bool
{
    // The existing writer closure exhausts the 16-site bytes-builder budget.
    // Other consumers exercise actual 4096/4097-byte projections; this closure
    // checks the very same shared bound without adding an owned allocation.
    projection_len_admitted(4096usize) && !projection_len_admitted(4097usize)
}

@id("std.log.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if projection_policy_cases() && projection_value_limit() { 0 } else { 1073741824 }
}
