module job_service.tests;
use function @id("job_service.core.dead_letter_is_reached") from job_service.core as dead_letter_is_reached;
use function @id("job_service.core.enqueue_outcome") from job_service.core as enqueue_outcome;
use function @id("job_service.core.job_status_is_complete") from job_service.core as job_status_is_complete;
use function @id("job_service.core.next_state_after_outcome") from job_service.core as next_state_after_outcome;
use function @id("job_service.core.run_scenario") from job_service.core as run_scenario;

// The whole acceptance scenario succeeds end to end.
@id("job_service.tests.scenario_succeeds")
fn scenario_succeeds() -> bool
{
    run_scenario() == 0
}

// A retried enqueue with the same idempotency key is a harmless duplicate
// (outcome 1), never a second job.
@id("job_service.tests.duplicate_enqueue_is_idempotent")
fn duplicate_enqueue_is_idempotent() -> bool
{
    let key = [7u8, 2u8, 9u8];
    enqueue_outcome(true, array_as_slice(key), array_as_slice(key)) == 1usize
}

// The same key reused for different work is a closed refusal (outcome 2),
// never a silent merge into the existing job.
@id("job_service.tests.conflicting_key_is_rejected")
fn conflicting_key_is_rejected() -> bool
{
    let key = [7u8, 2u8, 9u8];
    let other = [1u8];
    enqueue_outcome(true, array_as_slice(key), array_as_slice(other)) == 2usize
}

// A retryable failure is retried once within a two-attempt ceiling (still
// not a terminal state), and the same failure on the second attempt is
// dead-lettered (a terminal state) rather than retried forever.
@id("job_service.tests.retry_then_dead_letter")
fn retry_then_dead_letter() -> bool
{
    let first = next_state_after_outcome(1usize, 1u8, 2u8);
    let second = next_state_after_outcome(1usize, 2u8, 2u8);
    !job_status_is_complete(first) && job_status_is_complete(second) && dead_letter_is_reached(2u8, 2u8)
}

@id("job_service.tests.main")
fn main() -> i64
{
    if scenario_succeeds() && duplicate_enqueue_is_idempotent() && conflicting_key_is_rejected() && retry_then_dead_letter() { 0 } else { 1 }
}
