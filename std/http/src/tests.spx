@id("std.http.tests.digits")
fn digits() -> bool
{
    let text = [72u8, 84u8, 53u8, 32u8, 9u8, 55u8];
    let view = array_as_slice(text);
    digit_value(48u8) == 0 && digit_value(57u8) == 9 && digit_value(65u8) == -1 && digit_at(view, 2usize) == 5 && digit_at(view, 0usize) == -1 && digit_at(view, 6usize) == -1 && byte_is(view, 0usize, 72u8) && !byte_is(view, 6usize, 72u8) && lower(72u8) == 104u8 && lower(53u8) == 53u8 && skip_blanks(view, 3usize) == 5usize && skip_blanks(view, 0usize) == 0usize && decimal_at(view, 5usize) == 7 && decimal_at(view, 0usize) == -1
}

@id("std.http.tests.methods")
fn methods() -> bool
{
    let get = [71u8, 69u8, 84u8];
    let lower_case = [103u8, 101u8, 116u8];
    let spaced = [71u8, 69u8, 84u8, 32u8];
    let empty = [0u8; 0];
    method_is_valid(array_as_slice(get)) && !method_is_valid(array_as_slice(lower_case)) && !method_is_valid(array_as_slice(spaced)) && !method_is_valid(array_as_slice(empty)) && is_success(200) && is_success(299) && !is_success(199) && !is_success(301)
}

@id("std.http.tests.complete")
fn complete() -> bool
{
    let ok = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 50u8, 48u8, 48u8, 32u8, 79u8, 75u8, 13u8, 10u8, 99u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 108u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 53u8, 13u8, 10u8, 13u8, 10u8, 104u8, 101u8, 108u8, 108u8, 111u8];
    let view = array_as_slice(ok);
    status_code(view) == 200 && terminator(view) == 34usize && has_header_end(view) && header_end(view) == 38usize && body_len(view) == 5usize && name_at(view, 17usize) && !name_at(view, 0usize) && length_start(view) == 17usize && content_length(view) == 5
}

@id("std.http.tests.bodiless")
fn bodiless() -> bool
{
    let not_found = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 48u8, 32u8, 52u8, 48u8, 52u8, 32u8, 120u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 76u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 32u8, 48u8, 13u8, 10u8, 13u8, 10u8];
    let empty = [0u8; 0];
    let view = array_as_slice(not_found);
    status_code(view) == 404 && !is_success(status_code(view)) && has_header_end(view) && header_end(view) == 38usize && body_len(view) == 0usize && content_length(view) == 0 && !has_header_end(array_as_slice(empty)) && header_end(array_as_slice(empty)) == 0usize && content_length(array_as_slice(empty)) == -1 && status_code(array_as_slice(empty)) == -1
}

@id("std.http.tests.partial")
fn partial() -> bool
{
    let partial = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 50u8, 57u8, 57u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 76u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 49u8, 50u8];
    let view = array_as_slice(partial);
    status_code(view) == -1 && !has_header_end(view) && terminator(view) == 32usize && header_end(view) == 32usize && body_len(view) == 0usize && length_start(view) == 14usize && content_length(view) == -1
}

@id("std.http.tests.malformed")
fn malformed() -> bool
{
    let decoy = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 50u8, 48u8, 48u8, 32u8, 79u8, 75u8, 13u8, 10u8, 88u8, 45u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 76u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 49u8, 120u8, 13u8, 10u8, 13u8, 10u8];
    let view = array_as_slice(decoy);
    content_length(view) == -1 && length_start(view) == 37usize && decimal_at(view, 35usize) == -1
}

// Issue #193: the request-splitting boundary. Each separator is asserted
// on its own, and in the FINAL position as well as the middle, because a
// scan that stops one byte early passes every other case in this corpus --
// the same hole `std.email`'s corpus guards against.
@id("std.http.tests.header_value_refuses_each_separator")
fn header_value_refuses_each_separator() -> bool
{
    let clean = [97u8, 98u8, 99u8];
    let cr_middle = [97u8, 13u8, 99u8];
    let lf_middle = [97u8, 10u8, 99u8];
    let nul_middle = [97u8, 0u8, 99u8];
    let cr_final = [97u8, 98u8, 13u8];
    let lf_final = [97u8, 98u8, 10u8];
    let nul_final = [97u8, 98u8, 0u8];
    value_is_header_safe(array_as_slice(clean)) && !value_is_header_safe(array_as_slice(cr_middle)) && !value_is_header_safe(array_as_slice(lf_middle)) && !value_is_header_safe(array_as_slice(nul_middle)) && !value_is_header_safe(array_as_slice(cr_final)) && !value_is_header_safe(array_as_slice(lf_final)) && !value_is_header_safe(array_as_slice(nul_final))
}

// RFC 9110 field-name is a closed token set. A space and a colon are the two
// bytes that actually split one field into two, and both are outside it.
@id("std.http.tests.header_name_admits_only_tchar")
fn header_name_admits_only_tchar() -> bool
{
    let ok = [88u8, 45u8, 65u8, 95u8, 57u8];
    let with_space = [88u8, 32u8, 65u8];
    let with_colon = [88u8, 58u8, 65u8];
    let with_cr = [88u8, 13u8, 65u8];
    let too_long_marker = [88u8, 32u8];
    header_name_is_token(array_as_slice(ok)) && !header_name_is_token(array_as_slice(with_space)) && !header_name_is_token(array_as_slice(with_colon)) && !header_name_is_token(array_as_slice(with_cr)) && !header_name_is_token(array_as_slice(too_long_marker))
}

// A space in the target shifts the HTTP version field, so it is refused
// alongside the three separators.
@id("std.http.tests.request_target_refuses_space_and_separators")
fn request_target_refuses_space_and_separators() -> bool
{
    let ok = [47u8, 97u8];
    let with_space = [47u8, 32u8, 97u8];
    let with_cr = [47u8, 13u8, 97u8];
    let with_lf = [47u8, 10u8, 97u8];
    request_target_is_safe(array_as_slice(ok)) && !request_target_is_safe(array_as_slice(with_space)) && !request_target_is_safe(array_as_slice(with_cr)) && !request_target_is_safe(array_as_slice(with_lf))
}

@id("std.http.tests.request_line_needs_both_halves")
fn request_line_needs_both_halves() -> bool
{
    let get = [71u8, 69u8, 84u8];
    let lower_method = [103u8, 101u8, 116u8];
    let ok_target = [47u8, 97u8];
    let bad_target = [47u8, 13u8, 97u8];
    request_line_admitted(array_as_slice(get), array_as_slice(ok_target)) && !request_line_admitted(array_as_slice(lower_method), array_as_slice(ok_target)) && !request_line_admitted(array_as_slice(get), array_as_slice(bad_target))
}

// Issue #193's URL case: a userinfo component (`user:pass@host`) is the
// classic way a credential leaks through a URL. `request_target_is_safe`
// alone has no notion of it -- it refuses only the request-splitting bytes
// -- so an absolute-form target carrying live credentials passes it
// untouched. Both facts are pinned together: the old predicate's blind spot
// on the exact same bytes, and the new composed check that actually catches
// it.
@id("std.http.tests.request_target_is_safe_does_not_see_userinfo")
fn request_target_is_safe_does_not_see_userinfo() -> bool
{
    let with_credentials = [104u8, 116u8, 116u8, 112u8, 58u8, 47u8, 47u8, 117u8, 115u8, 101u8, 114u8, 58u8, 112u8, 97u8, 115u8, 115u8, 64u8, 104u8, 111u8, 115u8, 116u8];
    request_target_is_safe(array_as_slice(with_credentials)) && !request_target_admits_no_userinfo(array_as_slice(with_credentials))
}

// Origin-form (starts with `/`) never carries an authority component, so an
// `@` inside one (an email address in a query value, say) is ordinary
// content and stays admitted. Authority-form and absolute-form targets carry
// an authority, and RFC 7230 Section 5.3.3 says a sender must never generate
// userinfo in either: `@` there is refused, in the MIDDLE of the target and
// in its FINAL byte, since a scan that stops one byte early would pass the
// final-position case while catching every other one here.
@id("std.http.tests.request_target_admits_no_userinfo_cases")
fn request_target_admits_no_userinfo_cases() -> bool
{
    let origin_form_with_at = [47u8, 63u8, 101u8, 64u8, 98u8];
    let authority_form = [104u8, 111u8, 115u8, 116u8, 58u8, 56u8, 48u8];
    let authority_form_with_userinfo = [117u8, 64u8, 104u8, 111u8, 115u8, 116u8];
    let authority_form_userinfo_final = [104u8, 111u8, 115u8, 116u8, 64u8];
    let origin_admitted = target_is_origin_form(array_as_slice(origin_form_with_at)) && request_target_admits_no_userinfo(array_as_slice(origin_form_with_at));
    let authority_admitted = !target_is_origin_form(array_as_slice(authority_form)) && request_target_admits_no_userinfo(array_as_slice(authority_form));
    let userinfo_middle_refused = !request_target_admits_no_userinfo(array_as_slice(authority_form_with_userinfo));
    let userinfo_final_refused = !request_target_admits_no_userinfo(array_as_slice(authority_form_userinfo_final));
    origin_admitted && authority_admitted && userinfo_middle_refused && userinfo_final_refused
}

@id("std.http.tests.request_line_refuses_userinfo_in_target")
fn request_line_refuses_userinfo_in_target() -> bool
{
    let get = [71u8, 69u8, 84u8];
    let ok_target = [47u8, 97u8];
    let userinfo_target = [117u8, 64u8, 104u8, 111u8, 115u8, 116u8];
    request_line_admitted(array_as_slice(get), array_as_slice(ok_target)) && !request_line_admitted(array_as_slice(get), array_as_slice(userinfo_target))
}

// A bearer token in an outbound header is admitted by the byte-safety scan
// alone -- it carries no CR/LF/NUL -- so only the redaction guard catches it.
// Each of the six flags is asserted individually, and the byte-safety
// refusal is proven to still hold under the guard rather than being masked
// by it.
@id("std.http.tests.value_is_header_safe_guarded_refuses_each_secret_flag")
fn value_is_header_safe_guarded_refuses_each_secret_flag() -> bool
{
    let bearer = [66u8, 101u8, 97u8, 114u8, 101u8, 114u8, 32u8, 120u8, 121u8, 122u8];
    let safe = value_is_header_safe_guarded(array_as_slice(bearer), false, false, false, false, false, false);
    let password_refused = !value_is_header_safe_guarded(array_as_slice(bearer), true, false, false, false, false, false);
    let api_key_refused = !value_is_header_safe_guarded(array_as_slice(bearer), false, true, false, false, false, false);
    let bearer_token_refused = !value_is_header_safe_guarded(array_as_slice(bearer), false, false, true, false, false, false);
    let session_token_refused = !value_is_header_safe_guarded(array_as_slice(bearer), false, false, false, true, false, false);
    let webhook_secret_refused = !value_is_header_safe_guarded(array_as_slice(bearer), false, false, false, false, true, false);
    let smtp_credential_refused = !value_is_header_safe_guarded(array_as_slice(bearer), false, false, false, false, false, true);
    safe && password_refused && api_key_refused && bearer_token_refused && session_token_refused && webhook_secret_refused && smtp_credential_refused
}

@id("std.http.tests.value_is_header_safe_guarded_keeps_separator_refusal")
fn value_is_header_safe_guarded_keeps_separator_refusal() -> bool
{
    let injected = [97u8, 98u8, 13u8];
    !value_is_header_safe_guarded(array_as_slice(injected), false, false, false, false, false, false)
}

@id("std.http.tests.byte_is_at_sign_flags_only_at")
fn byte_is_at_sign_flags_only_at() -> bool
{
    byte_is_at_sign(64u8) && !byte_is_at_sign(63u8) && !byte_is_at_sign(65u8)
}

// Split from the URL/userinfo cases so a single aggregator never combines
// more than a handful of independent `if`/`else` branches (SPX-H006).
@id("std.http.tests.main_userinfo_and_guard")
fn main_userinfo_and_guard() -> i64
{
    let mut failed = 0;
    failed = failed + if byte_is_at_sign_flags_only_at() { 0 } else { 1024 };
    failed = failed + if request_target_is_safe_does_not_see_userinfo() { 0 } else { 2048 };
    failed = failed + if request_target_admits_no_userinfo_cases() { 0 } else { 4096 };
    failed = failed + if request_line_refuses_userinfo_in_target() { 0 } else { 8192 };
    failed = failed + if value_is_header_safe_guarded_refuses_each_secret_flag() { 0 } else { 16384 };
    failed = failed + if value_is_header_safe_guarded_keeps_separator_refusal() { 0 } else { 32768 };
    failed
}

@id("std.http.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if digits() { 0 } else { 1 };
    failed = failed + if methods() { 0 } else { 2 };
    failed = failed + if complete() { 0 } else { 4 };
    failed = failed + if bodiless() { 0 } else { 8 };
    failed = failed + if partial() { 0 } else { 16 };
    failed = failed + if malformed() { 0 } else { 32 };
    failed = failed + if header_value_refuses_each_separator() { 0 } else { 64 };
    failed = failed + if header_name_admits_only_tchar() { 0 } else { 128 };
    failed = failed + if request_target_refuses_space_and_separators() { 0 } else { 256 };
    failed = failed + if request_line_needs_both_halves() { 0 } else { 512 };
    failed + main_userinfo_and_guard() + projection_policy_failures() + outbound_policy_failures()
}

@id("std.http.tests.projection-policy-cases")
fn projection_policy_cases() -> bool
{
    let protected = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let public = [102u8, 105u8, 101u8, 108u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let suffixed = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8, 120u8];
    let injection = [102u8, 10u8];
    let invalid_commitment = [103u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refuses_named = !header_projection_admitted(array_as_slice(protected), false, array_as_slice(raw), absent);
    let refuses_classified = !header_projection_admitted(array_as_slice(public), true, array_as_slice(raw), absent);
    let admits_named_marker = header_projection_admitted(array_as_slice(protected), false, array_as_slice(marker), absent);
    let admits_value_marker = header_projection_admitted(array_as_slice(public), true, array_as_slice(marker), absent);
    let refuses_suffix = !header_projection_admitted(array_as_slice(protected), true, array_as_slice(suffixed), absent);
    let admits_public = header_projection_admitted(array_as_slice(public), false, array_as_slice(raw), absent);
    let refuses_injection = !header_projection_admitted(array_as_slice(injection), false, array_as_slice(raw), absent);
    let refuses_commitment = !header_projection_admitted(array_as_slice(protected), true, array_as_slice(marker), array_as_slice(invalid_commitment));
    refuses_named && refuses_classified && admits_named_marker && admits_value_marker && refuses_suffix && admits_public && refuses_injection && refuses_commitment
}

@id("std.http.tests.projection-value-limit")
fn projection_value_limit() -> bool
{
    let name = [102u8, 105u8, 101u8, 108u8, 100u8];
    let mut value = bytes_zeroed(4097usize);
    let mut index = 0usize;
    while index < 4097usize {
        value = bytes_set(value, index, 97u8);
        index = index + 1usize;
        index < 4097usize
    }
    let view = bytes_as_slice(value);
    let absent = byte_range(view, 0usize, 0usize);
    let at_limit = header_projection_admitted(array_as_slice(name), false, byte_range(view, 0usize, 4096usize), absent);
    let above_limit = !header_projection_admitted(array_as_slice(name), false, view, absent);
    at_limit && above_limit
}

@id("std.http.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if projection_policy_cases() && projection_value_limit() && diagnostic_target_cases() && diagnostic_target_limit() { 0 } else { 1073741824 }
}

@id("std.http.tests.diagnostic-target-cases")
fn diagnostic_target_cases() -> bool
{
    let path = [47u8, 116u8, 97u8, 115u8, 107u8, 115u8, 47u8, 55u8];
    let query = [47u8, 63u8, 116u8, 111u8, 107u8, 101u8, 110u8, 61u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let fragment = [47u8, 35u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let escaped = [47u8, 37u8, 55u8, 51u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let userinfo = [47u8, 117u8, 115u8, 101u8, 114u8, 64u8, 104u8, 111u8, 115u8, 116u8];
    let injection = [47u8, 13u8, 10u8];
    diagnostic_target_admitted(array_as_slice(path), false) && !diagnostic_target_admitted(array_as_slice(path), true) && !diagnostic_target_admitted(array_as_slice(query), false) && !diagnostic_target_admitted(array_as_slice(fragment), false) && !diagnostic_target_admitted(array_as_slice(escaped), false) && !diagnostic_target_admitted(array_as_slice(userinfo), false) && !diagnostic_target_admitted(array_as_slice(injection), false)
}

@id("std.http.tests.diagnostic-target-limit")
fn diagnostic_target_limit() -> bool
{
    let mut path = bytes_zeroed(2049usize);
    let mut index = 0usize;
    while index < 2049usize {
        path = bytes_set(path, index, 97u8);
        index = index + 1usize;
        index < 2049usize
    }
    path = bytes_set(path, 0usize, 47u8);
    let view = bytes_as_slice(path);
    diagnostic_target_admitted(byte_range(view, 0usize, 2048usize), false) && !diagnostic_target_admitted(view, false)
}

// ---------------------------------------------------------------------
// Issue #193: outbound client policy
// ---------------------------------------------------------------------
// Exactly five case-folded bytes. A prefix check admits `https-evil`, a
// case-sensitive one is bypassed by `HTTPS`, and a length-only check admits
// any five bytes.
@id("std.http.tests.scheme_match_is_exact_and_folded")
fn scheme_match_is_exact_and_folded() -> bool
{
    let https = [104u8, 116u8, 116u8, 112u8, 115u8];
    let upper = [72u8, 84u8, 84u8, 80u8, 83u8];
    let http = [104u8, 116u8, 116u8, 112u8];
    let prefixed = [104u8, 116u8, 116u8, 112u8, 115u8, 45u8, 120u8];
    let other = [104u8, 116u8, 116u8, 112u8, 122u8];
    scheme_is_https(array_as_slice(https)) && scheme_is_https(array_as_slice(upper)) && !scheme_is_https(array_as_slice(http)) && !scheme_is_https(array_as_slice(prefixed)) && !scheme_is_https(array_as_slice(other)) && scheme_is_http(array_as_slice(http)) && !scheme_is_http(array_as_slice(https))
}

// Cleartext is refused, not upgraded: `transport_admitted` says no to the
// scheme `http` rather than quietly rewriting it.
@id("std.http.tests.cleartext_is_refused_not_upgraded")
fn cleartext_is_refused_not_upgraded() -> bool
{
    let https = [104u8, 116u8, 116u8, 112u8, 115u8];
    let http = [104u8, 116u8, 116u8, 112u8];
    let empty = [0u8; 0];
    transport_admitted(array_as_slice(https)) && !transport_admitted(array_as_slice(http)) && !transport_admitted(array_as_slice(empty)) && scheme_byte_matches(array_as_slice(https), 0usize, 104u8) && !scheme_byte_matches(array_as_slice(https), 9usize, 104u8)
}

// The budget is inclusive at 1 and at its ceiling, and refuses 0 and one
// millisecond past the ceiling.
@id("std.http.tests.deadline_budget_boundary")
fn deadline_budget_boundary() -> bool
{
    let ceiling = deadline_millis_max();
    !deadline_admitted(0) && deadline_admitted(1) && deadline_admitted(ceiling) && !deadline_admitted(ceiling + 1) && !deadline_admitted(-1)
}

// Remaining time is clamped at zero and never exceeds the budget, so a
// caller cannot manufacture time by moving its own clock.
@id("std.http.tests.deadline_remaining_is_clamped")
fn deadline_remaining_is_clamped() -> bool
{
    let full = deadline_remaining(1000, 1000, 5000) == 5000;
    let partial = deadline_remaining(1000, 3000, 5000) == 3000;
    let edge = deadline_remaining(1000, 6000, 5000) == 0;
    let past = deadline_remaining(1000, 9000, 5000) == 0;
    let expired = !deadline_expired(1000, 5999, 5000) && deadline_expired(1000, 6000, 5000);
    full && partial && edge && past && expired
}

// Request and response ceilings are separate values, each inclusive at its
// limit and refusing one byte more.
@id("std.http.tests.body_budgets_are_separate_and_bounded")
fn body_budgets_are_separate_and_bounded() -> bool
{
    let request = request_body_limit();
    let response = response_body_limit();
    let distinct = request < response;
    let request_edge = request_body_admitted(request) && !request_body_admitted(request + 1usize);
    let response_edge = response_body_admitted(response) && !response_body_admitted(response + 1usize);
    let request_refuses_response_size = !request_body_admitted(response);
    distinct && request_edge && response_edge && request_refuses_response_size
}

// Depth is counted from 0 and stops strictly below the ceiling, so the
// maximum number of hops actually taken is `redirect_depth_max`.
@id("std.http.tests.redirect_depth_boundary")
fn redirect_depth_boundary() -> bool
{
    let ceiling = redirect_depth_max();
    redirect_depth_admitted(0) && redirect_depth_admitted(ceiling - 1) && !redirect_depth_admitted(ceiling) && !redirect_depth_admitted(-1)
}

// The closed redirect status set, and the 307/308 method-preserving split.
@id("std.http.tests.redirect_status_vocabulary")
fn redirect_status_vocabulary() -> bool
{
    let recognized = status_is_redirect(301) && status_is_redirect(302) && status_is_redirect(303) && status_is_redirect(307) && status_is_redirect(308);
    let rejected = !status_is_redirect(200) && !status_is_redirect(304) && !status_is_redirect(300) && !status_is_redirect(309);
    let preserved = redirect_preserves_method(307) && redirect_preserves_method(308);
    let rewritten = !redirect_preserves_method(301) && !redirect_preserves_method(302) && !redirect_preserves_method(303);
    recognized && rejected && preserved && rewritten
}

// Credentials cross none of the three origin components. Each of scheme,
// host and port is asserted alone, so dropping any one clause fails here.
@id("std.http.tests.credentials_do_not_cross_an_origin_boundary")
fn credentials_do_not_cross_an_origin_boundary() -> bool
{
    redirect_forwards_credentials(true, true, true) && !redirect_forwards_credentials(false, true, true) && !redirect_forwards_credentials(true, false, true) && !redirect_forwards_credentials(true, true, false)
}

// Every hop is re-judged: a redirect to a host the allowlist never named is
// refused even when the status, depth and scheme are all fine, and a
// downgrade to cleartext is refused even when the target was allowlisted.
@id("std.http.tests.each_redirect_hop_is_rejudged")
fn each_redirect_hop_is_rejudged() -> bool
{
    let https = [104u8, 116u8, 116u8, 112u8, 115u8];
    let http = [104u8, 116u8, 116u8, 112u8];
    let target = [47u8, 110u8, 101u8, 120u8, 116u8];
    let secure = array_as_slice(https);
    let path = array_as_slice(target);
    let admitted = redirect_admitted(307, 0, secure, path, true);
    let unlisted = !redirect_admitted(307, 0, secure, path, false);
    let downgraded = !redirect_admitted(307, 0, array_as_slice(http), path, true);
    let too_deep = !redirect_admitted(307, redirect_depth_max(), secure, path, true);
    let not_a_redirect = !redirect_admitted(200, 0, secure, path, true);
    admitted && unlisted && downgraded && too_deep && not_a_redirect
}

// A redirect target carrying userinfo is refused rather than stripped: the
// credential in it was never meant for the new origin.
@id("std.http.tests.redirect_refuses_userinfo_target")
fn redirect_refuses_userinfo_target() -> bool
{
    let https = [104u8, 116u8, 116u8, 112u8, 115u8];
    let userinfo = [104u8, 116u8, 116u8, 112u8, 115u8, 58u8, 47u8, 47u8, 117u8, 58u8, 112u8, 64u8, 104u8, 47u8, 120u8];
    !redirect_admitted(307, 0, array_as_slice(https), array_as_slice(userinfo), true)
}

// The outcome vocabulary is closed at both ends.
@id("std.http.tests.outcome_vocabulary_is_closed")
fn outcome_vocabulary_is_closed() -> bool
{
    outcome_admitted(0) && outcome_admitted(11) && !outcome_admitted(-1) && !outcome_admitted(12)
}

// Pre-origin failures are distinguished from post-origin ones. This is the
// distinction the retry rule is built on, so it is asserted directly rather
// than only through the composed rule. The four halves are separate
// functions because the cleanup-plan replay budget counts combined branch
// outcomes, not assertions.
@id("std.http.tests.outcomes_that_never_reached_the_origin")
fn outcomes_that_never_reached_the_origin() -> bool
{
    !outcome_may_have_reached_origin(1) && !outcome_may_have_reached_origin(2) && !outcome_may_have_reached_origin(3) && !outcome_may_have_reached_origin(4)
}

@id("std.http.tests.outcomes_that_may_have_reached_the_origin")
fn outcomes_that_may_have_reached_the_origin() -> bool
{
    outcome_may_have_reached_origin(0) && outcome_may_have_reached_origin(5) && outcome_may_have_reached_origin(7) && outcome_may_have_reached_origin(11)
}

@id("std.http.tests.uncertain_outcomes")
fn uncertain_outcomes() -> bool
{
    outcome_is_uncertain(5) && outcome_is_uncertain(6) && outcome_is_uncertain(9) && outcome_is_uncertain(11)
}

@id("std.http.tests.certain_outcomes")
fn certain_outcomes() -> bool
{
    !outcome_is_uncertain(0) && !outcome_is_uncertain(1) && !outcome_is_uncertain(2) && !outcome_is_uncertain(10)
}

// A policy refusal is never retried: it will be decided identically the
// second time, so retrying it is pure amplification.
@id("std.http.tests.transient_outcomes_are_retryable")
fn transient_outcomes_are_retryable() -> bool
{
    outcome_is_retryable(2) && outcome_is_retryable(3) && outcome_is_retryable(4) && outcome_is_retryable(5)
}

@id("std.http.tests.terminal_outcomes_are_not_retryable")
fn terminal_outcomes_are_not_retryable() -> bool
{
    !outcome_is_retryable(0) && !outcome_is_retryable(1) && !outcome_is_retryable(7) && !outcome_is_retryable(8)
}

@id("std.http.tests.server_transient_and_uncertain_are_retryable")
fn server_transient_and_uncertain_are_retryable() -> bool
{
    outcome_is_retryable(10) && outcome_is_retryable(11) && !outcome_is_retryable(6) && !outcome_is_retryable(9)
}

@id("std.http.tests.method_equality_and_idempotence")
fn method_equality_and_idempotence() -> bool
{
    let get = [71u8, 69u8, 84u8];
    let post = [80u8, 79u8, 83u8, 84u8];
    let patch = [80u8, 65u8, 84u8, 67u8, 72u8];
    let delete = [68u8, 69u8, 76u8, 69u8, 84u8, 69u8];
    let lower_get = [103u8, 101u8, 116u8];
    let equal = method_equals(array_as_slice(get), array_as_slice(get)) && !method_equals(array_as_slice(get), array_as_slice(post)) && !method_equals(array_as_slice(get), array_as_slice(lower_get));
    let idempotent = method_is_idempotent(array_as_slice(get)) && method_is_idempotent(array_as_slice(delete));
    let effectful = !method_is_idempotent(array_as_slice(post)) && !method_is_idempotent(array_as_slice(patch));
    equal && idempotent && effectful
}

@id("std.http.tests.attempt_budget_boundary")
fn attempt_budget_boundary() -> bool
{
    !attempt_admitted(0) && attempt_admitted(1) && attempt_admitted(5) && !attempt_admitted(6)
}

// The rule this issue names explicitly. A POST whose deadline expired may
// already have been processed, so it is not retried; the same POST with an
// idempotency key is, and so is a GET with neither.
@id("std.http.tests.non_idempotent_uncertain_request_is_not_retried")
fn non_idempotent_uncertain_request_is_not_retried() -> bool
{
    let post = [80u8, 79u8, 83u8, 84u8];
    let get = [71u8, 69u8, 84u8];
    let effectful = array_as_slice(post);
    let safe = array_as_slice(get);
    let refused = !retry_admitted(effectful, 5, 1, false);
    let keyed = retry_admitted(effectful, 5, 1, true);
    let idempotent = retry_admitted(safe, 5, 1, false);
    let pre_origin = retry_admitted(effectful, 2, 1, false);
    let spent = !retry_admitted(safe, 5, 6, true);
    let terminal = !retry_admitted(safe, 1, 1, true);
    refused && keyed && idempotent && pre_origin && spent && terminal
}

// Every clause of the composed admission refuses on its own while the other
// five hold, so a refusal is attributable to a named rule.
@id("std.http.tests.outbound_admission_is_attributable")
fn outbound_admission_is_attributable() -> bool
{
    let get = [71u8, 69u8, 84u8];
    let bad_method = [103u8, 101u8, 116u8];
    let https = [104u8, 116u8, 116u8, 112u8, 115u8];
    let http = [104u8, 116u8, 116u8, 112u8];
    let target = [47u8, 118u8, 49u8, 47u8, 112u8, 105u8, 110u8, 103u8];
    let spaced = [47u8, 118u8, 49u8, 32u8, 120u8];
    let method = array_as_slice(get);
    let scheme = array_as_slice(https);
    let path = array_as_slice(target);
    let all_hold = outbound_request_admitted(method, scheme, path, true, 1024usize, 5000);
    let method_only = !outbound_request_admitted(array_as_slice(bad_method), scheme, path, true, 1024usize, 5000);
    let scheme_only = !outbound_request_admitted(method, array_as_slice(http), path, true, 1024usize, 5000);
    let allowlist_only = !outbound_request_admitted(method, scheme, path, false, 1024usize, 5000);
    let target_only = !outbound_request_admitted(method, scheme, array_as_slice(spaced), true, 1024usize, 5000);
    let body_only = !outbound_request_admitted(method, scheme, path, true, request_body_limit() + 1usize, 5000);
    let deadline_only = !outbound_request_admitted(method, scheme, path, true, 1024usize, 0);
    all_hold && method_only && scheme_only && allowlist_only && target_only && body_only && deadline_only
}

@id("std.http.tests.outbound-policy-failures")
fn outbound_policy_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if scheme_match_is_exact_and_folded() { 0 } else { 4096 };
    failed = failed + if cleartext_is_refused_not_upgraded() { 0 } else { 8192 };
    failed = failed + if deadline_budget_boundary() { 0 } else { 16384 };
    failed = failed + if deadline_remaining_is_clamped() { 0 } else { 32768 };
    failed = failed + if body_budgets_are_separate_and_bounded() { 0 } else { 65536 };
    failed = failed + if redirect_depth_boundary() { 0 } else { 131072 };
    failed + outbound_redirect_failures()
}

@id("std.http.tests.outbound-redirect-failures")
fn outbound_redirect_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if redirect_status_vocabulary() { 0 } else { 262144 };
    failed = failed + if credentials_do_not_cross_an_origin_boundary() { 0 } else { 524288 };
    failed = failed + if each_redirect_hop_is_rejudged() { 0 } else { 1048576 };
    failed = failed + if redirect_refuses_userinfo_target() { 0 } else { 2097152 };
    failed = failed + if outcome_vocabulary_is_closed() { 0 } else { 4194304 };
    failed = failed + if outcomes_that_never_reached_the_origin() { 0 } else { 8388608 };
    failed + outbound_outcome_failures()
}

@id("std.http.tests.outbound-outcome-failures")
fn outbound_outcome_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if outcomes_that_may_have_reached_the_origin() { 0 } else { 16777216 };
    failed = failed + if uncertain_outcomes() { 0 } else { 33554432 };
    failed = failed + if certain_outcomes() { 0 } else { 67108864 };
    failed = failed + if transient_outcomes_are_retryable() { 0 } else { 134217728 };
    failed = failed + if terminal_outcomes_are_not_retryable() { 0 } else { 268435456 };
    failed = failed + if server_transient_and_uncertain_are_retryable() { 0 } else { 536870912 };
    failed + outbound_retry_failures()
}

@id("std.http.tests.outbound-retry-failures")
fn outbound_retry_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if method_equality_and_idempotence() { 0 } else { 1073741824 };
    failed = failed + if attempt_budget_boundary() { 0 } else { 2147483648 };
    failed = failed + if non_idempotent_uncertain_request_is_not_retried() { 0 } else { 4294967296 };
    failed = failed + if outbound_admission_is_attributable() { 0 } else { 8589934592 };
    failed
}
