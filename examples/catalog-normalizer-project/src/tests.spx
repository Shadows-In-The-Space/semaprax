// `owned-data-api.v1` requires every function reachable from `[exports]
// web` to be contract-free; `std.data.json.dec` uses `ensures` throughout
// (by design -- see its own tests), so nothing that reaches `token_valid`/
// `trimmed_matches` through it can be a web export. This trivial function
// is the one this project lists there instead; every real assertion lives
// in the named `test_*` cases below, exercised by `semaprax test`.
@id("catalog_normalizer.tests.smoke")
fn smoke() -> bool
{
    true
}

// Every case below reproduces one label value from
// `tests/oracle/catalog_normalizer/cases/published/basics.json` byte for
// byte: the raw JSON string token (position 0 in its own tiny buffer) is
// this project's own input, and the expected decoded/trimmed bytes are
// copied from that frozen case's own `expected_output` (never edited to
// make a run pass; cross-checked against the oracle with a one-off
// script, not hand-transcribed).
// "basic-single-record": label value "hello" -> unchanged (no boundary
// whitespace to trim). Also exercises CNORM-010's decode path directly
// (`decoded_matches`) as well as the trim (`trimmed_matches`).
@id("catalog_normalizer.tests.test-basic-label")
fn test_basic_label() -> i64
{
    let token = "\"hello\"";
    let token_text = string_as_str(token);
    let view = str_as_bytes(token_text);
    let expected = "hello";
    let expected_text = string_as_str(expected);
    let expected_view = str_as_bytes(expected_text);
    if token_valid(view, 0usize) && decoded_matches(view, 0usize, expected_view) && trimmed_matches(view, 0usize, expected_view) { 0 } else { 1 }
}

// "label-trim-boundary-whitespace": " \t hello world \t " -> "hello world".
// CNORM-012's flagship rule: a `\t` escape is trimmed exactly like a raw
// space on both boundaries, interior whitespace is untouched.
@id("catalog_normalizer.tests.test-label-trim-boundary-whitespace")
fn test_label_trim_boundary_whitespace() -> i64
{
    let token = "\" \\t hello world \\t \"";
    let token_text = string_as_str(token);
    let view = str_as_bytes(token_text);
    let expected = "hello world";
    let expected_text = string_as_str(expected);
    let expected_view = str_as_bytes(expected_text);
    if token_valid(view, 0usize) && trimmed_matches(view, 0usize, expected_view) { 0 } else { 1 }
}

// "label-internal-whitespace-preserved": "hello    world" -> unchanged;
// interior whitespace is never touched.
@id("catalog_normalizer.tests.test-label-internal-whitespace-preserved")
fn test_label_internal_whitespace_preserved() -> i64
{
    let token = "\"hello    world\"";
    let token_text = string_as_str(token);
    let view = str_as_bytes(token_text);
    let expected = "hello    world";
    let expected_text = string_as_str(expected);
    let expected_view = str_as_bytes(expected_text);
    if token_valid(view, 0usize) && trimmed_matches(view, 0usize, expected_view) { 0 } else { 1 }
}

// "label-multibyte-unicode-no-normalization": "  Café STRASSE ÜBER  " ->
// "Café STRASSE ÜBER" -- raw multi-byte UTF-8 passed through unchanged, no
// case folding or Unicode normalization.
@id("catalog_normalizer.tests.test-label-multibyte-unicode-no-normalization")
fn test_label_multibyte_unicode_no_normalization() -> i64
{
    let token = "\"  Café STRASSE ÜBER  \"";
    let token_text = string_as_str(token);
    let view = str_as_bytes(token_text);
    let expected = "Café STRASSE ÜBER";
    let expected_text = string_as_str(expected);
    let expected_view = str_as_bytes(expected_text);
    if token_valid(view, 0usize) && trimmed_matches(view, 0usize, expected_view) { 0 } else { 1 }
}

// CNORM-010: an unterminated string is a decode failure, not a value.
// Self-authored (not a literal oracle case reproduction), following
// `tests/oracle/catalog_normalizer/cases/published/errors.json`'s own
// "malformed-json-unterminated-string-rejected" pattern.
@id("catalog_normalizer.tests.test-unterminated-string-rejected")
fn test_unterminated_string_rejected() -> i64
{
    let token = "\"never closes";
    let token_text = string_as_str(token);
    if !token_valid(str_as_bytes(token_text), 0usize) { 0 } else { 1 }
}

@id("catalog_normalizer.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if test_basic_label() == 0 { 0 } else { 1 };
    failed = failed + if test_label_trim_boundary_whitespace() == 0 { 0 } else { 2 };
    failed = failed + if test_label_internal_whitespace_preserved() == 0 { 0 } else { 4 };
    failed = failed + if test_label_multibyte_unicode_no_normalization() == 0 { 0 } else { 8 };
    failed = failed + if test_unterminated_string_rejected() == 0 { 0 } else { 16 };
    failed = failed + if test_batch_boundaries() == 0 { 0 } else { 32 };
    failed = failed + if test_batch_limits() == 0 { 0 } else { 64 };
    failed = failed + if test_decoded_id_rules() == 0 { 0 } else { 128 };
    failed = failed + if test_batch_utf8() == 0 { 0 } else { 256 };
    failed = failed + if test_checked_total() == 0 { 0 } else { 512 };
    failed = failed + if test_record_parser() == 0 { 0 } else { 1024 };
    failed = failed + if test_duplicate_batch() == 0 { 0 } else { 2048 };
    failed = failed + if test_canonical_responses() == 0 { 0 } else { 4096 };
    failed = failed + if test_fixture_enrichment() == 0 { 0 } else { 8192 };
    failed
}

// CNORM-011/014. The accepted 64-byte id, rejected 65-byte id, and escaped
// duplicate are each represented as raw JSON string tokens. The independent
// oracle's published limits/errors cases define the same boundaries and
// decoded-value duplicate rule.
@id("catalog_normalizer.tests.ids")
fn test_decoded_id_rules() -> i64
{
    let mut id_boundary = bytes_zeroed(67usize);
    id_boundary = bytes_set(id_boundary, 0usize, 34u8);
    let mut index = 1usize;
    while index < 66usize {
        id_boundary = bytes_set(id_boundary, index, 120u8);
        index = index + 1usize;
        index < 66usize
    }
    id_boundary = bytes_set(id_boundary, 66usize, 34u8);
    let too_long_rejected = !id_token_valid(bytes_as_slice(id_boundary), 0usize);
    id_boundary = bytes_set(id_boundary, 65usize, 34u8);
    let boundary_view = bytes_as_slice(id_boundary);
    let exact = byte_range(boundary_view, 0usize, 66usize);
    let empty = "\"\"";
    let duplicate_tokens = "\"dup\"\"d\\u0075p\"";
    let empty_text = string_as_str(empty);
    let empty_view = str_as_bytes(empty_text);
    let duplicate_text = string_as_str(duplicate_tokens);
    let duplicate_view = str_as_bytes(duplicate_text);
    if id_token_valid(exact, 0usize) && too_long_rejected && !id_token_valid(empty_view, 0usize) && same_decoded_id(duplicate_view, 0usize, 5usize) { 0 } else { 1 }
}

@id("catalog_normalizer.tests.test-batch-boundaries")
fn test_batch_boundaries() -> i64
{
    let empty = [0u8];
    let one_lf = "\n";
    let two_lf = "\n\n";
    let two = "a\nb\n";
    let empty_view = array_as_slice(empty);
    let zero = byte_range(empty_view, 0usize, 0usize);
    let one_lf_text = string_as_str(one_lf);
    let one_lf_view = str_as_bytes(one_lf_text);
    let two_lf_text = string_as_str(two_lf);
    let two_lf_view = str_as_bytes(two_lf_text);
    let two_text = string_as_str(two);
    let two_view = str_as_bytes(two_text);
    if record_count(zero) == 0usize && record_count(one_lf_view) == 0usize && record_count(two_lf_view) == 2usize && line_empty(two_lf_view, 0usize) && record_count(two_view) == 2usize && line_start(two_view, 1usize) == 2usize && line_end(two_view, 2usize) == 3usize && !line_empty(two_view, 1usize) && !line_too_long(two_view, 1usize) && !body_too_long(two_view) && !too_many_records(two_view) { 0 } else { 1 }
}

@id("catalog_normalizer.tests.test-batch-limits")
fn test_batch_limits() -> i64
{
    let mut records = bytes_zeroed(513usize);
    let initial = bytes_as_slice(records);
    let exact_line = byte_range(initial, 0usize, 512usize);
    let length_ok = !line_too_long(exact_line, 0usize) && line_too_long(initial, 0usize);
    let mut index = 0usize;
    while index < 513usize {
        records = bytes_set(records, index, 97u8);
        index = index + 2usize;
        index < 513usize
    }
    let mut gap = 1usize;
    while gap < 513usize {
        records = bytes_set(records, gap, 10u8);
        gap = gap + 2usize;
        gap < 513usize
    }
    let records_view = bytes_as_slice(records);
    if length_ok && record_count(records_view) == 257usize && too_many_records(records_view) { 0 } else { 1 }
}

// CNORM-005/020: the position is the leading byte of an invalid sequence,
// following the frozen Unicode decode-error convention, not a character count.
@id("catalog_normalizer.tests.test-batch-utf8")
fn test_batch_utf8() -> i64
{
    let valid = "{é}";
    let invalid_lead = [123u8, 195u8, 40u8, 125u8];
    let overlong = [91u8, 224u8, 128u8, 128u8, 93u8];
    let surrogate = [91u8, 237u8, 160u8, 128u8, 93u8];
    let too_large = [91u8, 244u8, 144u8, 128u8, 128u8, 93u8];
    let valid_text = string_as_str(valid);
    let valid_view = str_as_bytes(valid_text);
    if line_utf8_valid(valid_view, 0usize) && !line_utf8_valid(array_as_slice(invalid_lead), 0usize) && line_utf8_fault(array_as_slice(invalid_lead), 0usize) == 1usize && !line_utf8_valid(array_as_slice(overlong), 0usize) && line_utf8_fault(array_as_slice(overlong), 0usize) == 1usize && !line_utf8_valid(array_as_slice(surrogate), 0usize) && line_utf8_fault(array_as_slice(surrogate), 0usize) == 1usize && !line_utf8_valid(array_as_slice(too_large), 0usize) && line_utf8_fault(array_as_slice(too_large), 0usize) == 1usize { 0 } else { 1 }
}

// CNORM-015: the second record in the frozen overflow example is rejected
// before addition; the retained total proves this helper cannot wrap.
@id("catalog_normalizer.tests.test-checked-total")
fn test_checked_total() -> i64
{
    let maximum = 9223372036854775807;
    if !total_would_overflow(0, maximum) && total_after(0, maximum) == maximum && !total_would_overflow(maximum - 1, 1) && total_after(maximum - 1, 1) == maximum && total_would_overflow(maximum, 1) && total_after(maximum, 1) == maximum && total_would_overflow(maximum - 1, 2) && total_after(maximum - 1, 2) == maximum - 1 && !total_would_overflow(40, 2) && total_after(40, 2) == 42 { 0 } else { 1 }
}

// CNORM-006..011: structural scanner failures precede schema failures; a
// schema key error points at that raw key, and a type error at its value.
// These cases are deliberately source-authored rather than copied output
// fixtures, while the Rust owning gate compares their categories/positions
// to a live independent-oracle invocation.
@id("catalog_normalizer.tests.test-record-parser")
fn test_record_parser() -> i64
{
    let valid = "{\"id\":\"a\",\"label\":\"x\",\"quantity\":1}";
    let missing = "{\"id\":\"a\",\"label\":\"x\"}";
    let wrong_quantity = "{\"id\":\"a\",\"label\":\"x\",\"quantity\":\"1\"}";
    let escaped_key = "{\"\\u0069d\":\"a\",\"label\":\"x\",\"quantity\":1}";
    let malformed = "{\"id\":\"a";
    let valid_text = string_as_str(valid);
    let missing_text = string_as_str(missing);
    let wrong_quantity_text = string_as_str(wrong_quantity);
    let escaped_key_text = string_as_str(escaped_key);
    let malformed_text = string_as_str(malformed);
    let valid_problem = record_problem(str_as_bytes(valid_text));
    let missing_problem = record_problem(str_as_bytes(missing_text));
    let quantity_problem = record_problem(str_as_bytes(wrong_quantity_text));
    let escaped_problem = record_problem(str_as_bytes(escaped_key_text));
    let malformed_problem = record_problem(str_as_bytes(malformed_text));
    if valid_problem == 0usize && problem_category(missing_problem) == 4usize && problem_offset(missing_problem) == 0usize && problem_category(quantity_problem) == 4usize && problem_offset(quantity_problem) == 33usize && problem_category(escaped_problem) == 4usize && problem_offset(escaped_problem) == 1usize && problem_category(malformed_problem) == 3usize && problem_offset(malformed_problem) == 8usize { 0 } else { 1 }
}

// CNORM-014: the second decoded-equivalent id is rejected, even though its
// raw spelling uses a JSON escape.  The helper returns `record_count` when
// no duplicate exists, which makes the sentinel independent of a magic id.
@id("catalog_normalizer.tests.test-duplicate-batch")
fn test_duplicate_batch() -> i64
{
    let body = "{\"id\":\"a\",\"label\":\"\",\"quantity\":0}\n{\"id\":\"\\u0061\",\"label\":\"\",\"quantity\":0}";
    let body_text = string_as_str(body);
    if first_duplicate_record(str_as_bytes(body_text)) == 1usize { 0 } else { 1 }
}

// CNORM-016/040..042: the success and error branches produce one canonical
// line each. The response helper itself selects failure before allocating the
// success projection, so the error check also guards all-or-nothing output.
@id("catalog_normalizer.tests.test-canonical-responses")
fn test_canonical_responses() -> i64
{
    let success = "{\"id\":\"a\",\"label\":\" x \",\"quantity\":1}";
    let duplicate = "{\"id\":\"a\",\"label\":\"\",\"quantity\":0}\n{\"id\":\"\\u0061\",\"label\":\"\",\"quantity\":0}";
    let expected_success = "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"a\",\"label\":\"x\",\"quantity\":1}]}\n";
    let expected_duplicate = "{\"status\":\"error\",\"category\":\"duplicate_id\",\"record_index\":1,\"byte_offset\":6}\n";
    let success_text = string_as_str(success);
    let success_view = str_as_bytes(success_text);
    let duplicate_text = string_as_str(duplicate);
    let duplicate_view = str_as_bytes(duplicate_text);
    let expected_success_text = string_as_str(expected_success);
    let expected_success_view = str_as_bytes(expected_success_text);
    let expected_duplicate_text = string_as_str(expected_duplicate);
    let expected_duplicate_view = str_as_bytes(expected_duplicate_text);
    if normalizes_to(success_view, expected_success_view) && normalizes_to(duplicate_view, expected_duplicate_view) { 0 } else { 1 }
}

// CNORM-060..062: this is deliberately an opt-in frozen fixture lookup, not
// a network request. Terminal outcomes select an error before the writer owns
// any response bytes; the final input proves record-zero provider failure wins
// over a malformed later record.
@id("catalog_normalizer.tests.test-fixture-enrichment")
fn test_fixture_enrichment() -> i64
{
    let found = "{\"id\":\"widget-1\",\"label\":\" l \",\"quantity\":1}";
    let missing = "{\"id\":\"known-missing\",\"label\":\"l\",\"quantity\":1}";
    let blocked = "{\"id\":\"blocked-vendor\",\"label\":\"l\",\"quantity\":1}";
    let timeout = "{\"id\":\"slow-vendor\",\"label\":\"l\",\"quantity\":1}";
    let malformed = "{\"id\":\"garbled-vendor\",\"label\":\"l\",\"quantity\":1}";
    let provider_first = "{\"id\":\"blocked-vendor\",\"label\":\"l\",\"quantity\":1}\n{\"id\":\"later\",\"label\":\"l\",\"quantity\":-1}";
    let found_expected = "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"widget-1\",\"label\":\"l\",\"quantity\":1,\"category\":7}]}\n";
    let missing_expected = "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"known-missing\",\"label\":\"l\",\"quantity\":1,\"category\":null}]}\n";
    let disabled_expected = "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"blocked-vendor\",\"label\":\"l\",\"quantity\":1}]}\n";
    let denied_expected = "{\"status\":\"error\",\"category\":\"provider_denied\",\"record_index\":0,\"byte_offset\":6}\n";
    let timeout_expected = "{\"status\":\"error\",\"category\":\"provider_timeout\",\"record_index\":0,\"byte_offset\":6}\n";
    let malformed_expected = "{\"status\":\"error\",\"category\":\"provider_malformed\",\"record_index\":0,\"byte_offset\":6}\n";
    let found_text = string_as_str(found);
    let missing_text = string_as_str(missing);
    let blocked_text = string_as_str(blocked);
    let timeout_text = string_as_str(timeout);
    let malformed_text = string_as_str(malformed);
    let provider_first_text = string_as_str(provider_first);
    let found_expected_text = string_as_str(found_expected);
    let missing_expected_text = string_as_str(missing_expected);
    let disabled_expected_text = string_as_str(disabled_expected);
    let denied_expected_text = string_as_str(denied_expected);
    let timeout_expected_text = string_as_str(timeout_expected);
    let malformed_expected_text = string_as_str(malformed_expected);
    if normalizes_enriched_to(str_as_bytes(found_text), str_as_bytes(found_expected_text)) && normalizes_enriched_to(str_as_bytes(missing_text), str_as_bytes(missing_expected_text)) && normalizes_to(str_as_bytes(blocked_text), str_as_bytes(disabled_expected_text)) && normalizes_enriched_to(str_as_bytes(blocked_text), str_as_bytes(denied_expected_text)) && normalizes_enriched_to(str_as_bytes(timeout_text), str_as_bytes(timeout_expected_text)) && normalizes_enriched_to(str_as_bytes(malformed_text), str_as_bytes(malformed_expected_text)) && normalizes_enriched_to(str_as_bytes(provider_first_text), str_as_bytes(denied_expected_text)) { 0 } else { 1 }
}
