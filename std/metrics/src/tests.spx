module std.metrics.tests;
use function @id("std.metrics.try-admit-projected-series") from std.metrics as try_admit_projected_series;
use function @id("std.metrics.label-projection-admitted") from std.metrics as label_projection_admitted;
use function @id("std.metrics.cardinality-limit") from std.metrics as cardinality_limit;
use function @id("std.metrics.counter-increment") from std.metrics as counter_increment;
use function @id("std.metrics.gauge-clamped") from std.metrics as gauge_clamped;
use function @id("std.metrics.histogram-observe-count") from std.metrics as histogram_observe_count;
use function @id("std.metrics.histogram-observe-sum") from std.metrics as histogram_observe_sum;
use function @id("std.metrics.try-admit-series") from std.metrics as try_admit_series;
use function @id("std.metrics.byte-is-label-name-start") from std.metrics as byte_is_label_name_start;
use function @id("std.metrics.byte-is-label-name-char") from std.metrics as byte_is_label_name_char;
use function @id("std.metrics.label-name-max-len") from std.metrics as label_name_max_len;
use function @id("std.metrics.label-name-is-valid") from std.metrics as label_name_is_valid;
use function @id("std.metrics.byte-is-label-value-unsafe") from std.metrics as byte_is_label_value_unsafe;
use function @id("std.metrics.value-is-label-safe") from std.metrics as value_is_label_safe;
use function @id("std.metrics.label-value-max-len") from std.metrics as label_value_max_len;
use function @id("std.metrics.label-value-len-admitted") from std.metrics as label_value_len_admitted;
use function @id("std.metrics.label-count-max") from std.metrics as label_count_max;
use function @id("std.metrics.label-count-admitted") from std.metrics as label_count_admitted;
use function @id("std.metrics.label-admitted") from std.metrics as label_admitted;
use function @id("std.metrics.try-admit-labeled-series") from std.metrics as try_admit_labeled_series;
use function @id("std.metrics.label-admitted-guarded") from std.metrics as label_admitted_guarded;
use function @id("std.metrics.try-admit-labeled-series-guarded") from std.metrics as try_admit_labeled_series_guarded;
use function @id("std.metrics.byte-is-metric-name-start") from std.metrics as byte_is_metric_name_start;
use function @id("std.metrics.byte-is-metric-name-char") from std.metrics as byte_is_metric_name_char;
use function @id("std.metrics.metric-name-max-len") from std.metrics as metric_name_max_len;
use function @id("std.metrics.metric-name-admitted") from std.metrics as metric_name_admitted;
use function @id("std.metrics.byte-is-unit-char") from std.metrics as byte_is_unit_char;
use function @id("std.metrics.metric-unit-admitted") from std.metrics as metric_unit_admitted;
use function @id("std.metrics.metric-kind-admitted") from std.metrics as metric_kind_admitted;
use function @id("std.metrics.counter-delta-admitted") from std.metrics as counter_delta_admitted;
use function @id("std.metrics.counter-reset-detected") from std.metrics as counter_reset_detected;
use function @id("std.metrics.delta-admitted-for-kind") from std.metrics as delta_admitted_for_kind;
use function @id("std.metrics.bucket-count-max") from std.metrics as bucket_count_max;
use function @id("std.metrics.bucket-count-admitted") from std.metrics as bucket_count_admitted;
use function @id("std.metrics.bucket-bound-follows") from std.metrics as bucket_bound_follows;
use function @id("std.metrics.bucket-selects") from std.metrics as bucket_selects;
use function @id("std.metrics.cumulative-count-follows") from std.metrics as cumulative_count_follows;
use function @id("std.metrics.histogram-totals-admitted") from std.metrics as histogram_totals_admitted;
use function @id("std.metrics.overflow-series-slot") from std.metrics as overflow_series_slot;
use function @id("std.metrics.series-slot") from std.metrics as series_slot;
use function @id("std.metrics.series-was-aggregated") from std.metrics as series_was_aggregated;
use function @id("std.metrics.deployment-series-limit") from std.metrics as deployment_series_limit;
use function @id("std.metrics.deployment-series-admitted") from std.metrics as deployment_series_admitted;
