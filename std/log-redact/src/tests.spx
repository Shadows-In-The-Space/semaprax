module std.log.redact.tests;
use function @id("std.log.redact.normalized-name-byte") from std.log.redact as normalized_name_byte;
use function @id("std.log.redact.name-byte-admitted") from std.log.redact as name_byte_admitted;
use function @id("std.log.redact.normalized-name-matches") from std.log.redact as normalized_name_matches;
use function @id("std.log.redact.projection-len-admitted") from std.log.redact as projection_len_admitted;
use function @id("std.log.redact.projected-field-admitted") from std.log.redact as projected_field_admitted;
use function @id("std.log.redact.field-name-is-protected") from std.log.redact as field_name_is_protected;
use function @id("std.log.redact.field-name-admitted") from std.log.redact as field_name_admitted;
use function @id("std.log.redact.commitment-shape-admitted") from std.log.redact as commitment_shape_admitted;
use function @id("std.log.redact.event_is_safe") from std.log.redact as event_is_safe;
use function @id("std.log.redact.bytes_match_marker") from std.log.redact as bytes_match_marker;
use function @id("std.log.redact.marker_byte") from std.log.redact as marker_byte;
use function @id("std.log.redact.marker_len") from std.log.redact as marker_len;
use function @id("std.log.redact.field_count_within_budget") from std.log.redact as field_count_within_budget;

// Copies `std.auth.tests.audit_event_safety`'s exact shape: a clean-event
// positive, then each of the six secret-bearing fields asserted unsafe
// INDIVIDUALLY (never combined), so a regression that stops checking any one
// flag fails this test rather than hiding behind the other five.
@id("std.log.redact.tests.event_safety")
fn event_safety() -> bool
{
    let clean_event_is_safe = event_is_safe(false, false, false, false, false, false);
    let raw_password_is_unsafe = !event_is_safe(true, false, false, false, false, false);
    let api_key_is_unsafe = !event_is_safe(false, true, false, false, false, false);
    let bearer_token_is_unsafe = !event_is_safe(false, false, true, false, false, false);
    let session_token_is_unsafe = !event_is_safe(false, false, false, true, false, false);
    let webhook_signing_secret_is_unsafe = !event_is_safe(false, false, false, false, true, false);
    let smtp_credential_is_unsafe = !event_is_safe(false, false, false, false, false, true);
    clean_event_is_safe && raw_password_is_unsafe && api_key_is_unsafe && bearer_token_is_unsafe && session_token_is_unsafe && webhook_signing_secret_is_unsafe && smtp_credential_is_unsafe
}

// Two secret-bearing flags at once are still refused - the closed check is
// not merely "at most one flag", it is "none of the six".
@id("std.log.redact.tests.multiple_secrets_still_unsafe")
fn multiple_secrets_still_unsafe() -> bool
{
    !event_is_safe(true, false, false, false, false, true) && !event_is_safe(false, true, true, true, true, true)
}

// The marker a real writer would emit for a refused field self-matches
// byte-for-byte, built the same way a writer's own `bytes_set` loop would
// build it (never via this package returning owned bytes - see `redact.spx`
// module comment for why).
@id("std.log.redact.tests.marker_self_consistency")
fn marker_self_consistency() -> bool
{
    let mut marker = bytes_zeroed(10usize);
    let mut index = 0usize;
    while index < 10usize {
        marker = bytes_set(marker, index, marker_byte(index));
        index = index + 1usize;
        index < 10usize
    }
    bytes_match_marker(bytes_as_slice(marker)) && byte_len(bytes_as_slice(marker)) == marker_len()
}

// The negative control the marker check exists for: a secret's own bytes
// (wrong length, and separately the right length but wrong content) must
// never be mistaken for the redacted marker. If this ever passed, a writer
// bug that emitted the raw secret instead of the marker would go undetected.
@id("std.log.redact.tests.secret_shaped_content_never_matches_marker")
fn secret_shaped_content_never_matches_marker() -> bool
{
    let shorter_secret = [104u8, 117u8, 110u8, 116u8, 101u8, 114u8, 50u8];
    let same_length_secret = [104u8, 117u8, 110u8, 116u8, 101u8, 114u8, 50u8, 33u8, 33u8, 33u8];
    let empty = [0u8; 0];
    !bytes_match_marker(array_as_slice(shorter_secret)) && !bytes_match_marker(array_as_slice(same_length_secret)) && !bytes_match_marker(array_as_slice(empty))
}

// A single flipped byte at the very end of an otherwise-exact marker still
// fails the check, proving the comparison loop runs to the last byte rather
// than short-circuiting on a shared prefix (mirrors
// `std.auth.tests.constant_time_equality`'s `differs_last` case).
@id("std.log.redact.tests.one_flipped_trailing_byte_never_matches_marker")
fn one_flipped_trailing_byte_never_matches_marker() -> bool
{
    let almost = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 33u8];
    !bytes_match_marker(array_as_slice(almost))
}

// Step 2 requires a redacted marker that does not vary with the secret's own
// content: a marker whose bytes leaked even the secret's LENGTH would itself
// be a leak. `marker_byte` takes only an `index`, never anything derived
// from a secret, so this is not merely tested but structurally guaranteed by
// the function's own signature: there is no parameter through which a
// secret's length or bytes could reach it. This pins that operationally by
// rendering the marker "as if" redacting a 3-byte secret, split from a
// second rendering "as if" redacting a 500-byte secret below (this
// package's conformance module keeps at most one `Bytes` value live per
// function): both equal the one fixed marker, which makes them equal to
// each other.
@id("std.log.redact.tests.marker_rendered_for_a_short_secret")
fn marker_rendered_for_a_short_secret() -> bool
{
    let mut rendered = bytes_zeroed(10usize);
    let mut index = 0usize;
    while index < 10usize {
        rendered = bytes_set(rendered, index, marker_byte(index));
        index = index + 1usize;
        index < 10usize
    }
    bytes_match_marker(bytes_as_slice(rendered))
}

@id("std.log.redact.tests.marker_rendered_for_a_long_secret")
fn marker_rendered_for_a_long_secret() -> bool
{
    let mut rendered = bytes_zeroed(10usize);
    let mut index = 0usize;
    while index < 10usize {
        rendered = bytes_set(rendered, index, marker_byte(index));
        index = index + 1usize;
        index < 10usize
    }
    bytes_match_marker(bytes_as_slice(rendered))
}

@id("std.log.redact.tests.marker_is_identical_for_different_secret_lengths")
fn marker_is_identical_for_different_secret_lengths() -> bool
{
    marker_rendered_for_a_short_secret() && marker_rendered_for_a_long_secret()
}

@id("std.log.redact.tests.budget_boundary")
fn budget_boundary() -> bool
{
    let zero_is_within_budget = field_count_within_budget(0usize);
    let exactly_at_budget = field_count_within_budget(32usize);
    let one_past_budget_is_refused = !field_count_within_budget(33usize);
    zero_is_within_budget && exactly_at_budget && one_past_budget_is_refused
}

@id("std.log.redact.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if event_safety() { 0 } else { 1 };
    failed = failed + if multiple_secrets_still_unsafe() { 0 } else { 2 };
    failed = failed + if marker_self_consistency() { 0 } else { 4 };
    failed = failed + if secret_shaped_content_never_matches_marker() { 0 } else { 8 };
    failed = failed + if one_flipped_trailing_byte_never_matches_marker() { 0 } else { 16 };
    failed = failed + if budget_boundary() { 0 } else { 32 };
    failed = failed + if marker_is_identical_for_different_secret_lengths() { 0 } else { 64 };
    failed + projection_policy_failures()
}

@id("std.log.redact.tests.protected-name-aliases")
fn protected_name_aliases() -> bool
{
    let password = [80u8, 65u8, 83u8, 83u8, 87u8, 79u8, 82u8, 68u8];
    let api_key = [65u8, 112u8, 105u8, 45u8, 75u8, 101u8, 121u8];
    let normalized_api_key = [97u8, 112u8, 105u8, 95u8, 107u8, 101u8, 121u8];
    let bearer = [98u8, 101u8, 97u8, 114u8, 101u8, 114u8, 95u8, 116u8, 111u8, 107u8, 101u8, 110u8];
    let session = [115u8, 101u8, 115u8, 115u8, 105u8, 111u8, 110u8, 45u8, 116u8, 111u8, 107u8, 101u8, 110u8];
    let webhook = [119u8, 101u8, 98u8, 104u8, 111u8, 111u8, 107u8, 95u8, 115u8, 105u8, 103u8, 110u8, 105u8, 110u8, 103u8, 95u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let smtp = [115u8, 109u8, 116u8, 112u8, 45u8, 99u8, 114u8, 101u8, 100u8, 101u8, 110u8, 116u8, 105u8, 97u8, 108u8];
    normalized_name_byte(65u8) == 97u8 && normalized_name_byte(45u8) == 95u8 && normalized_name_byte(126u8) == 126u8 && name_byte_admitted(65u8) && name_byte_admitted(45u8) && !name_byte_admitted(32u8) && !name_byte_admitted(13u8) && normalized_name_matches(array_as_slice(api_key), array_as_slice(normalized_api_key)) && !normalized_name_matches(array_as_slice(password), array_as_slice(normalized_api_key)) && field_name_is_protected(array_as_slice(password)) && field_name_is_protected(array_as_slice(api_key)) && field_name_is_protected(array_as_slice(bearer)) && field_name_is_protected(array_as_slice(session)) && field_name_is_protected(array_as_slice(webhook)) && field_name_is_protected(array_as_slice(smtp))
}

@id("std.log.redact.tests.protected-header-aliases")
fn protected_header_aliases() -> bool
{
    let authorization = [65u8, 117u8, 116u8, 104u8, 111u8, 114u8, 105u8, 122u8, 97u8, 116u8, 105u8, 111u8, 110u8];
    let proxy = [80u8, 114u8, 111u8, 120u8, 121u8, 45u8, 65u8, 117u8, 116u8, 104u8, 111u8, 114u8, 105u8, 122u8, 97u8, 116u8, 105u8, 111u8, 110u8];
    let cookie = [67u8, 111u8, 111u8, 107u8, 105u8, 101u8];
    let set_cookie = [83u8, 101u8, 116u8, 45u8, 67u8, 111u8, 111u8, 107u8, 105u8, 101u8];
    let access = [97u8, 99u8, 99u8, 101u8, 115u8, 115u8, 95u8, 116u8, 111u8, 107u8, 101u8, 110u8];
    let refresh = [114u8, 101u8, 102u8, 114u8, 101u8, 115u8, 104u8, 45u8, 116u8, 111u8, 107u8, 101u8, 110u8];
    field_name_is_protected(array_as_slice(authorization)) && field_name_is_protected(array_as_slice(proxy)) && field_name_is_protected(array_as_slice(cookie)) && field_name_is_protected(array_as_slice(set_cookie)) && field_name_is_protected(array_as_slice(access)) && field_name_is_protected(array_as_slice(refresh))
}

@id("std.log.redact.tests.projection-shape-bounds")
fn projection_shape_bounds() -> bool
{
    let mut data = bytes_zeroed(65usize);
    let mut index = 0usize;
    while index < 65usize {
        data = bytes_set(data, index, 97u8);
        index = index + 1usize;
        index < 65usize
    }
    let view = bytes_as_slice(data);
    let max = byte_range(view, 0usize, 64usize);
    let empty = byte_range(view, 0usize, 0usize);
    let name_max = field_name_admitted(max);
    let name_plus_one = !field_name_admitted(view);
    let name_empty = !field_name_admitted(empty);
    let commitment_max = commitment_shape_admitted(max);
    let commitment_plus_one = !commitment_shape_admitted(view);
    let commitment_absent = commitment_shape_admitted(empty);
    name_max && name_plus_one && name_empty && commitment_max && commitment_plus_one && commitment_absent && projection_len_admitted(0usize) && projection_len_admitted(4096usize) && !projection_len_admitted(4097usize)
}

@id("std.log.redact.tests.projection-commitment-is-not-a-bypass")
fn projection_commitment_is_not_a_bypass() -> bool
{
    let name = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let ordinary = [102u8, 105u8, 101u8, 108u8, 100u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let raw = [110u8, 111u8, 116u8, 45u8, 114u8, 101u8, 100u8, 97u8, 99u8, 116u8, 101u8, 100u8];
    let mut commitment = bytes_zeroed(64usize);
    let mut index = 0usize;
    while index < 64usize {
        commitment = bytes_set(commitment, index, 97u8);
        index = index + 1usize;
        index < 64usize
    }
    let bound_marker = projected_field_admitted(array_as_slice(name), false, array_as_slice(marker), bytes_as_slice(commitment));
    let raw_refused = !projected_field_admitted(array_as_slice(name), false, array_as_slice(raw), bytes_as_slice(commitment));
    let public_commitment_refused = !projected_field_admitted(array_as_slice(ordinary), false, array_as_slice(raw), bytes_as_slice(commitment));
    commitment = bytes_set(commitment, 0usize, 65u8);
    let upper_refused = !commitment_shape_admitted(bytes_as_slice(commitment));
    commitment = bytes_set(commitment, 0usize, 10u8);
    let injection_refused = !commitment_shape_admitted(bytes_as_slice(commitment));
    bound_marker && raw_refused && public_commitment_refused && upper_refused && injection_refused
}

@id("std.log.redact.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if protected_name_aliases() && protected_header_aliases() && projection_shape_bounds() && projection_commitment_is_not_a_bypass() { 0 } else { 128 }
}
