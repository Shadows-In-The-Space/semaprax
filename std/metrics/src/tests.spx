@id("std.metrics.tests.counter_increment_accumulates")
fn counter_increment_accumulates() -> bool
{
    counter_increment(counter_increment(0, 3), 4) == 7
}

@id("std.metrics.tests.gauge_clamped_within_range")
fn gauge_clamped_within_range() -> bool
{
    gauge_clamped(3, 0, 5) == 3
}

@id("std.metrics.tests.gauge_clamped_saturates_high_and_low")
fn gauge_clamped_saturates_high_and_low() -> bool
{
    gauge_clamped(9, 0, 5) == 5 && gauge_clamped(-9, 0, 5) == 0
}

@id("std.metrics.tests.histogram_accumulates_count_and_sum")
fn histogram_accumulates_count_and_sum() -> bool
{
    let count = histogram_observe_count(histogram_observe_count(0));
    let sum = histogram_observe_sum(histogram_observe_sum(0, 10), 5);
    count == 2 && sum == 15
}

// One below the limit: admission succeeds and returns the grown count,
// landing exactly on cardinality_limit().
@id("std.metrics.tests.admits_one_below_the_limit")
fn admits_one_below_the_limit() -> bool
{
    try_admit_series(cardinality_limit() - 1) == cardinality_limit()
}

// The negative control that matters: a registry already AT the cardinality
// limit refuses the next admission outright -- fails closed, proven by the
// fixed -1 refusal sentinel, not by inspecting a count that silently kept
// growing past the bound or a silently-dropped no-op "success".
@id("std.metrics.tests.refuses_at_the_limit")
fn refuses_at_the_limit() -> bool
{
    try_admit_series(cardinality_limit()) == -1
}

// ---------------------------------------------------------------------
// Labels (issue #193)
// ---------------------------------------------------------------------
@id("std.metrics.tests.byte_is_label_name_start_admits_letters_and_underscore_only")
fn byte_is_label_name_start_admits_letters_and_underscore_only() -> bool
{
    byte_is_label_name_start(97u8) && byte_is_label_name_start(90u8) && byte_is_label_name_start(95u8) && !byte_is_label_name_start(57u8) && !byte_is_label_name_start(32u8)
}

@id("std.metrics.tests.byte_is_label_name_char_admits_digits_too")
fn byte_is_label_name_char_admits_digits_too() -> bool
{
    byte_is_label_name_char(57u8) && byte_is_label_name_char(97u8) && byte_is_label_name_char(95u8) && !byte_is_label_name_char(32u8) && !byte_is_label_name_char(45u8)
}

@id("std.metrics.tests.byte_is_label_value_unsafe_flags_exact_set")
fn byte_is_label_value_unsafe_flags_exact_set() -> bool
{
    byte_is_label_value_unsafe(10u8) && byte_is_label_value_unsafe(13u8) && byte_is_label_value_unsafe(0u8) && byte_is_label_value_unsafe(34u8) && byte_is_label_value_unsafe(92u8) && !byte_is_label_value_unsafe(97u8)
}

// A leading digit is refused (Prometheus label-name grammar reserves the
// first byte), a space is refused wherever it appears, and the empty name is
// refused by the length floor, not by falling through the byte scan.
@id("std.metrics.tests.label_name_admits_allowed_bytes_only")
fn label_name_admits_allowed_bytes_only() -> bool
{
    let ok = [114u8, 111u8, 117u8, 116u8, 101u8, 95u8, 57u8];
    let with_space_middle = [114u8, 32u8, 117u8];
    let with_space_final = [114u8, 111u8, 32u8];
    let leading_digit = [57u8, 97u8, 98u8];
    let empty = [0u8; 0];
    label_name_is_valid(array_as_slice(ok)) && !label_name_is_valid(array_as_slice(with_space_middle)) && !label_name_is_valid(array_as_slice(with_space_final)) && !label_name_is_valid(array_as_slice(leading_digit)) && !label_name_is_valid(array_as_slice(empty))
}

@id("std.metrics.tests.label_name_len_bounds_at_max_and_max_plus_one")
fn label_name_len_bounds_at_max_and_max_plus_one() -> bool
{
    let max_len = [97u8; 64];
    let over_max = [97u8; 65];
    label_name_max_len() == 64usize && label_name_is_valid(array_as_slice(max_len)) && !label_name_is_valid(array_as_slice(over_max))
}

// Line feed, carriage return and NUL each break a Prometheus-style text
// exposition value or the transport underneath it. Each is asserted in the
// FINAL byte position as well as the middle: a scan that stops one byte
// early would pass every case here except the middle ones.
@id("std.metrics.tests.label_value_refuses_line_and_nul_bytes")
fn label_value_refuses_line_and_nul_bytes() -> bool
{
    let clean = [97u8, 98u8, 99u8];
    let lf_middle = [97u8, 10u8, 99u8];
    let lf_final = [97u8, 98u8, 10u8];
    let cr_middle = [97u8, 13u8, 99u8];
    let cr_final = [97u8, 98u8, 13u8];
    let nul_middle = [97u8, 0u8, 99u8];
    let nul_final = [97u8, 98u8, 0u8];
    value_is_label_safe(array_as_slice(clean)) && !value_is_label_safe(array_as_slice(lf_middle)) && !value_is_label_safe(array_as_slice(lf_final)) && !value_is_label_safe(array_as_slice(cr_middle)) && !value_is_label_safe(array_as_slice(cr_final)) && !value_is_label_safe(array_as_slice(nul_middle)) && !value_is_label_safe(array_as_slice(nul_final))
}

// The Prometheus text format's own value escape covers exactly backslash and
// double quote alongside line feed, so both are refused outright here too,
// again in the final position as well as the middle.
@id("std.metrics.tests.label_value_refuses_quote_and_backslash")
fn label_value_refuses_quote_and_backslash() -> bool
{
    let clean = [97u8, 98u8, 99u8];
    let quote_middle = [97u8, 34u8, 99u8];
    let quote_final = [97u8, 98u8, 34u8];
    let backslash_middle = [97u8, 92u8, 99u8];
    let backslash_final = [97u8, 98u8, 92u8];
    value_is_label_safe(array_as_slice(clean)) && !value_is_label_safe(array_as_slice(quote_middle)) && !value_is_label_safe(array_as_slice(quote_final)) && !value_is_label_safe(array_as_slice(backslash_middle)) && !value_is_label_safe(array_as_slice(backslash_final))
}

// A label value may be empty; the bound is an upper one, checked at the
// limit and one past it.
@id("std.metrics.tests.label_value_len_bounds_at_max_and_max_plus_one")
fn label_value_len_bounds_at_max_and_max_plus_one() -> bool
{
    let max_len = [97u8; 128];
    let over_max = [97u8; 129];
    label_value_max_len() == 128usize && label_value_len_admitted(0usize) && label_value_len_admitted(byte_len(array_as_slice(max_len))) && !label_value_len_admitted(byte_len(array_as_slice(over_max)))
}

// Zero labels (an unlabeled series) is admitted, the bound itself is
// admitted, one past it is refused, and a negative count -- which no real
// caller should be able to construct but a hostile one might pass -- is
// refused rather than accidentally admitted by an unchecked lower bound.
@id("std.metrics.tests.label_count_bounds_at_zero_max_and_over")
fn label_count_bounds_at_zero_max_and_over() -> bool
{
    label_count_max() == 32 && label_count_admitted(0) && label_count_admitted(label_count_max()) && !label_count_admitted(label_count_max() + 1) && !label_count_admitted(-1)
}

// The composed judgement: a bad name alone or a bad value alone each sink
// the whole label, and a refusal is attributable to whichever half failed.
@id("std.metrics.tests.label_admitted_composes_name_and_value")
fn label_admitted_composes_name_and_value() -> bool
{
    let ok_name = [114u8, 111u8, 117u8, 116u8, 101u8];
    let ok_value = [47u8, 104u8, 101u8, 97u8, 108u8, 116u8, 104u8];
    let bad_name = [32u8];
    let bad_value = [97u8, 10u8];
    label_admitted(array_as_slice(ok_name), array_as_slice(ok_value)) && !label_admitted(array_as_slice(bad_name), array_as_slice(ok_value)) && !label_admitted(array_as_slice(ok_name), array_as_slice(bad_value))
}

// The negative control that matters most for this issue: a registry with
// plenty of cardinality budget left (existing_count == 0) still refuses a
// series keyed by a bad label, proving admission actually inspects the
// label rather than only counting an abstract series as `try_admit_series`
// does. The cardinality bound itself still applies to a good label, at one
// below and exactly at `cardinality_limit()`.
@id("std.metrics.tests.try_admit_labeled_series_sees_the_label")
fn try_admit_labeled_series_sees_the_label() -> bool
{
    let ok_name = [114u8, 111u8, 117u8, 116u8, 101u8];
    let ok_value = [47u8, 104u8, 101u8, 97u8, 108u8, 116u8, 104u8];
    let bad_name = [32u8];
    try_admit_labeled_series(0, array_as_slice(ok_name), array_as_slice(ok_value)) == 1 && try_admit_labeled_series(0, array_as_slice(bad_name), array_as_slice(ok_value)) == -1 && try_admit_labeled_series(cardinality_limit() - 1, array_as_slice(ok_name), array_as_slice(ok_value)) == cardinality_limit() && try_admit_labeled_series(cardinality_limit(), array_as_slice(ok_name), array_as_slice(ok_value)) == -1
}

// ---------------------------------------------------------------------
// Redaction guard (issue #193)
// ---------------------------------------------------------------------
// Issue #193's hole in this package, pinned directly: a password shaped like
// "hunter2" carries none of `value_is_label_safe`'s five refused bytes, so
// the shape-only `label_admitted` ADMITS it -- this is the leak surface, not
// a hypothetical. Only the guarded entry point, which also consults the
// caller's `carries_password` classification, refuses it.
@id("std.metrics.tests.shape_valid_label_admits_a_password_without_the_guard")
fn shape_valid_label_admits_a_password_without_the_guard() -> bool
{
    let name = [114u8, 111u8, 117u8, 116u8, 101u8];
    let password_shaped_value = [104u8, 117u8, 110u8, 116u8, 101u8, 114u8, 50u8];
    label_admitted(array_as_slice(name), array_as_slice(password_shaped_value))
}

// Each of the six flags is asserted individually against the same
// shape-valid value, so a regression that stops consulting any one of them
// fails here rather than hiding behind the other five; the all-false case
// proves the guard does not refuse an ordinary label it should admit.
@id("std.metrics.tests.label_admitted_guarded_refuses_each_secret_flag")
fn label_admitted_guarded_refuses_each_secret_flag() -> bool
{
    let name = [114u8, 111u8, 117u8, 116u8, 101u8];
    let value = [104u8, 117u8, 110u8, 116u8, 101u8, 114u8, 50u8];
    let clean = array_as_slice(name);
    let secret = array_as_slice(value);
    let safe = label_admitted_guarded(clean, secret, false, false, false, false, false, false);
    let password_refused = !label_admitted_guarded(clean, secret, true, false, false, false, false, false);
    let api_key_refused = !label_admitted_guarded(clean, secret, false, true, false, false, false, false);
    let bearer_token_refused = !label_admitted_guarded(clean, secret, false, false, true, false, false, false);
    let session_token_refused = !label_admitted_guarded(clean, secret, false, false, false, true, false, false);
    let webhook_secret_refused = !label_admitted_guarded(clean, secret, false, false, false, false, true, false);
    let smtp_credential_refused = !label_admitted_guarded(clean, secret, false, false, false, false, false, true);
    safe && password_refused && api_key_refused && bearer_token_refused && session_token_refused && webhook_secret_refused && smtp_credential_refused
}

// The registry-facing entry point: a secret-classified label never grows the
// series count (the fixed `-1` sentinel), even with a full cardinality
// budget available, and an ordinary label under the guard behaves exactly
// like the unguarded admission path.
@id("std.metrics.tests.try_admit_labeled_series_guarded_refuses_secret_labels")
fn try_admit_labeled_series_guarded_refuses_secret_labels() -> bool
{
    let name = [114u8, 111u8, 117u8, 116u8, 101u8];
    let value = [104u8, 117u8, 110u8, 116u8, 101u8, 114u8, 50u8];
    let clean = array_as_slice(name);
    let secret = array_as_slice(value);
    let admits_clean = try_admit_labeled_series_guarded(0, clean, secret, false, false, false, false, false, false) == 1;
    let refuses_secret = try_admit_labeled_series_guarded(0, clean, secret, true, false, false, false, false, false) == -1;
    admits_clean && refuses_secret
}

// Split from `main` into three smaller aggregators, each summing a disjoint
// subset of unique failure bits, and combined by addition in `main` below.
// A single 17-branch aggregator exceeded the cleanup-replay skeleton-work
// budget (`SPX-H006`): "restructure the branches to be mutually exclusive
// ... or combine their results across separate calls instead" is the
// diagnostic's own remedy, and this is the "separate calls" half of it.
@id("std.metrics.tests.main_scalars")
fn main_scalars() -> i64
{
    let mut failed = 0;
    failed = failed + if counter_increment_accumulates() { 0 } else { 1 };
    failed = failed + if gauge_clamped_within_range() { 0 } else { 2 };
    failed = failed + if gauge_clamped_saturates_high_and_low() { 0 } else { 4 };
    failed = failed + if histogram_accumulates_count_and_sum() { 0 } else { 8 };
    failed = failed + if admits_one_below_the_limit() { 0 } else { 16 };
    failed = failed + if refuses_at_the_limit() { 0 } else { 32 };
    failed
}

@id("std.metrics.tests.main_label_bytes")
fn main_label_bytes() -> i64
{
    let mut failed = 0;
    failed = failed + if byte_is_label_name_start_admits_letters_and_underscore_only() { 0 } else { 64 };
    failed = failed + if byte_is_label_name_char_admits_digits_too() { 0 } else { 128 };
    failed = failed + if byte_is_label_value_unsafe_flags_exact_set() { 0 } else { 256 };
    failed = failed + if label_name_admits_allowed_bytes_only() { 0 } else { 512 };
    failed = failed + if label_name_len_bounds_at_max_and_max_plus_one() { 0 } else { 1024 };
    failed = failed + if label_value_refuses_line_and_nul_bytes() { 0 } else { 2048 };
    failed
}

@id("std.metrics.tests.main_label_admission")
fn main_label_admission() -> i64
{
    let mut failed = 0;
    failed = failed + if label_value_refuses_quote_and_backslash() { 0 } else { 4096 };
    failed = failed + if label_value_len_bounds_at_max_and_max_plus_one() { 0 } else { 8192 };
    failed = failed + if label_count_bounds_at_zero_max_and_over() { 0 } else { 16384 };
    failed = failed + if label_admitted_composes_name_and_value() { 0 } else { 32768 };
    failed = failed + if try_admit_labeled_series_sees_the_label() { 0 } else { 65536 };
    failed
}

@id("std.metrics.tests.main_redaction_guard")
fn main_redaction_guard() -> i64
{
    let mut failed = 0;
    failed = failed + if shape_valid_label_admits_a_password_without_the_guard() { 0 } else { 1 };
    failed = failed + if label_admitted_guarded_refuses_each_secret_flag() { 0 } else { 2 };
    failed = failed + if try_admit_labeled_series_guarded_refuses_secret_labels() { 0 } else { 4 };
    failed
}

@id("std.metrics.tests.main")
fn main() -> i64
{
    main_scalars() + main_label_bytes() + main_label_admission() + main_redaction_guard() * 131072 + projection_policy_failures() + metric_identity_failures()
}

@id("std.metrics.tests.projection-policy-cases")
fn projection_policy_cases() -> bool
{
    let protected = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let public = [102u8, 105u8, 101u8, 108u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let suffixed = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8, 120u8];
    let injection = [102u8, 10u8];
    let invalid_commitment = [103u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refuses_named = !label_projection_admitted(array_as_slice(protected), false, array_as_slice(raw), absent);
    let refuses_classified = !label_projection_admitted(array_as_slice(public), true, array_as_slice(raw), absent);
    let admits_named_marker = label_projection_admitted(array_as_slice(protected), false, array_as_slice(marker), absent);
    let admits_value_marker = label_projection_admitted(array_as_slice(public), true, array_as_slice(marker), absent);
    let refuses_suffix = !label_projection_admitted(array_as_slice(protected), true, array_as_slice(suffixed), absent);
    let admits_public = label_projection_admitted(array_as_slice(public), false, array_as_slice(raw), absent);
    let refuses_injection = !label_projection_admitted(array_as_slice(injection), false, array_as_slice(raw), absent);
    let refuses_commitment = !label_projection_admitted(array_as_slice(protected), true, array_as_slice(marker), array_as_slice(invalid_commitment));
    refuses_named && refuses_classified && admits_named_marker && admits_value_marker && refuses_suffix && admits_public && refuses_injection && refuses_commitment
}

@id("std.metrics.tests.projection-value-limit")
fn projection_value_limit() -> bool
{
    let name = [102u8, 105u8, 101u8, 108u8, 100u8];
    let mut value = bytes_zeroed(129usize);
    let mut index = 0usize;
    while index < 129usize {
        value = bytes_set(value, index, 97u8);
        index = index + 1usize;
        index < 129usize
    }
    let view = bytes_as_slice(value);
    let absent = byte_range(view, 0usize, 0usize);
    let at_limit = label_projection_admitted(array_as_slice(name), false, byte_range(view, 0usize, 128usize), absent);
    let above_limit = !label_projection_admitted(array_as_slice(name), false, view, absent);
    at_limit && above_limit
}

@id("std.metrics.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if projection_policy_cases() && projection_value_limit() && projected_registry_enforces_policy() { 0 } else { 1073741824 }
}

@id("std.metrics.tests.projected-registry-enforces-policy")
fn projected_registry_enforces_policy() -> bool
{
    let name = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refused = try_admit_projected_series(0, array_as_slice(name), false, raw_view, absent) == -1;
    let at_limit = try_admit_projected_series(cardinality_limit() - 1, array_as_slice(name), false, array_as_slice(marker), absent) == cardinality_limit();
    let over_limit = try_admit_projected_series(cardinality_limit(), array_as_slice(name), false, array_as_slice(marker), absent) == -1;
    refused && at_limit && over_limit
}

// ---------------------------------------------------------------------
// Issue #193: metric identity, counter monotonicity, histogram buckets
// ---------------------------------------------------------------------
@id("std.metrics.tests.metric_name_alphabet")
fn metric_name_alphabet() -> bool
{
    byte_is_metric_name_start(97u8) && byte_is_metric_name_start(122u8) && byte_is_metric_name_start(95u8) && !byte_is_metric_name_start(65u8) && !byte_is_metric_name_start(48u8) && !byte_is_metric_name_start(46u8)
}

@id("std.metrics.tests.metric_name_continuation_alphabet")
fn metric_name_continuation_alphabet() -> bool
{
    byte_is_metric_name_char(48u8) && byte_is_metric_name_char(57u8) && byte_is_metric_name_char(46u8) && byte_is_metric_name_char(97u8) && !byte_is_metric_name_char(65u8) && !byte_is_metric_name_char(45u8)
}

// A name assembled from a request path creates a new metric per request,
// which no per-metric series budget can contain. That shape is refused by
// construction, and so is a leading digit and an uppercase spelling.
@id("std.metrics.tests.metric_name_refuses_per_request_shapes")
fn metric_name_refuses_per_request_shapes() -> bool
{
    let stable = [104u8, 116u8, 116u8, 112u8, 46u8, 115u8, 101u8, 114u8, 118u8, 101u8, 114u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 100u8, 117u8, 114u8, 97u8, 116u8, 105u8, 111u8, 110u8];
    let per_request = [104u8, 116u8, 116u8, 112u8, 46u8, 115u8, 101u8, 114u8, 118u8, 101u8, 114u8, 46u8, 47u8, 117u8, 115u8, 101u8, 114u8, 115u8, 47u8, 52u8, 55u8, 49u8, 49u8];
    let shouting = [72u8, 116u8, 116u8, 112u8, 46u8, 83u8, 101u8, 114u8, 118u8, 101u8, 114u8, 46u8, 82u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 115u8];
    let leading_digit = [53u8, 120u8, 120u8, 46u8, 114u8, 101u8, 115u8, 112u8, 111u8, 110u8, 115u8, 101u8, 115u8];
    let empty = [0u8; 0];
    metric_name_admitted(array_as_slice(stable)) && !metric_name_admitted(array_as_slice(per_request)) && !metric_name_admitted(array_as_slice(shouting)) && !metric_name_admitted(array_as_slice(leading_digit)) && !metric_name_admitted(array_as_slice(empty))
}

@id("std.metrics.tests.metric_name_length_window")
fn metric_name_length_window() -> bool
{
    let at_limit = [97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8];
    let over_limit = [97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8];
    metric_name_max_len() == 128usize && metric_name_admitted(array_as_slice(at_limit)) && !metric_name_admitted(array_as_slice(over_limit))
}

// An empty unit is dimensionless and admitted; an arbitrary one is not.
@id("std.metrics.tests.metric_unit_cases")
fn metric_unit_cases() -> bool
{
    let millis = [109u8, 115u8];
    let rate = [114u8, 101u8, 113u8, 47u8, 115u8];
    let spaced = [112u8, 101u8, 114u8, 32u8, 115u8, 101u8, 99u8, 111u8, 110u8, 100u8];
    let empty = [0u8; 0];
    byte_is_unit_char(47u8) && metric_unit_admitted(array_as_slice(millis)) && metric_unit_admitted(array_as_slice(rate)) && metric_unit_admitted(array_as_slice(empty)) && !metric_unit_admitted(array_as_slice(spaced))
}

@id("std.metrics.tests.metric_kind_vocabulary")
fn metric_kind_vocabulary() -> bool
{
    metric_kind_admitted(0) && metric_kind_admitted(3) && !metric_kind_admitted(-1) && !metric_kind_admitted(4)
}

// A counter only goes up, and an up-down counter is a different kind rather
// than a counter with a relaxed rule.
@id("std.metrics.tests.counter_never_decreases")
fn counter_never_decreases() -> bool
{
    let deltas = counter_delta_admitted(0) && counter_delta_admitted(1) && !counter_delta_admitted(-1);
    let counter = delta_admitted_for_kind(0, 1) && !delta_admitted_for_kind(0, -1);
    let up_down = delta_admitted_for_kind(3, -1) && delta_admitted_for_kind(3, 1);
    deltas && counter && up_down
}

@id("std.metrics.tests.counter_reset_is_reported_not_hidden")
fn counter_reset_is_reported_not_hidden() -> bool
{
    counter_reset_detected(10, 0) && counter_reset_detected(10, 9) && !counter_reset_detected(10, 10) && !counter_reset_detected(0, 10)
}

@id("std.metrics.tests.bucket_count_boundary")
fn bucket_count_boundary() -> bool
{
    let ceiling = bucket_count_max();
    !bucket_count_admitted(0usize) && bucket_count_admitted(1usize) && bucket_count_admitted(ceiling) && !bucket_count_admitted(ceiling + 1usize)
}

// Strictly increasing, not merely non-decreasing: two equal adjacent bounds
// create a bucket that can never be selected.
@id("std.metrics.tests.bucket_bounds_are_strictly_increasing")
fn bucket_bounds_are_strictly_increasing() -> bool
{
    bucket_bound_follows(1, 2) && bucket_bound_follows(-5, 0) && !bucket_bound_follows(2, 2) && !bucket_bound_follows(3, 2)
}

// Upper-inclusive, lower-exclusive: the value exactly on a bound belongs to
// the bucket below it, and the other convention would shift every quantile.
@id("std.metrics.tests.bucket_selection_is_upper_inclusive")
fn bucket_selection_is_upper_inclusive() -> bool
{
    bucket_selects(10, 5, 10) && bucket_selects(6, 5, 10) && !bucket_selects(5, 5, 10) && !bucket_selects(11, 5, 10)
}

@id("std.metrics.tests.cumulative_counts_never_decrease")
fn cumulative_counts_never_decrease() -> bool
{
    cumulative_count_follows(0, 0) && cumulative_count_follows(3, 7) && !cumulative_count_follows(7, 3) && !cumulative_count_follows(-1, 0)
}

// More bucketed observations than observations made is a counting bug, and
// it is refused rather than exported.
@id("std.metrics.tests.histogram_totals_are_consistent")
fn histogram_totals_are_consistent() -> bool
{
    histogram_totals_admitted(10, 10) && histogram_totals_admitted(10, 4) && !histogram_totals_admitted(10, 11) && !histogram_totals_admitted(-1, 0)
}

// Overflow folds into one reserved slot rather than vanishing: the layout is
// identical on every run, and the boundary is exactly the per-metric limit.
@id("std.metrics.tests.overflow_aggregation_is_deterministic")
fn overflow_aggregation_is_deterministic() -> bool
{
    let limit = cardinality_limit();
    let first = series_slot(0) == 1;
    let last = series_slot(limit - 1) == limit;
    let overflowed = series_slot(limit) == overflow_series_slot();
    let beyond = series_slot(limit + 1) == overflow_series_slot();
    let flagged = !series_was_aggregated(limit - 1) && series_was_aggregated(limit);
    first && last && overflowed && beyond && flagged
}

// A whole-deployment ceiling above the per-metric one: a process holding a
// hundred within-budget metrics is still past what a collector accepts.
@id("std.metrics.tests.deployment_budget_boundary")
fn deployment_budget_boundary() -> bool
{
    let ceiling = deployment_series_limit();
    let above_per_metric = ceiling > cardinality_limit();
    deployment_series_admitted(0) && deployment_series_admitted(ceiling) && !deployment_series_admitted(ceiling + 1) && !deployment_series_admitted(-1) && above_per_metric
}

// Every clause of the composed metric judgement refuses on its own.
@id("std.metrics.tests.metric_admission_is_attributable")
fn metric_admission_is_attributable() -> bool
{
    let name = [104u8, 116u8, 116u8, 112u8, 46u8, 115u8, 101u8, 114u8, 118u8, 101u8, 114u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 100u8, 117u8, 114u8, 97u8, 116u8, 105u8, 111u8, 110u8];
    let shouting = [72u8, 116u8, 116u8, 112u8, 46u8, 83u8, 101u8, 114u8, 118u8, 101u8, 114u8];
    let unit = [109u8, 115u8];
    let spaced = [112u8, 101u8, 114u8, 32u8, 115u8, 101u8, 99u8, 111u8, 110u8, 100u8];
    let metric = array_as_slice(name);
    let unit_view = array_as_slice(unit);
    let all_hold = metric_admitted(metric, unit_view, 2, 4);
    let name_only = !metric_admitted(array_as_slice(shouting), unit_view, 2, 4);
    let unit_only = !metric_admitted(metric, array_as_slice(spaced), 2, 4);
    let kind_only = !metric_admitted(metric, unit_view, 4, 4);
    let labels_only = !metric_admitted(metric, unit_view, 2, 33);
    all_hold && name_only && unit_only && kind_only && labels_only
}

@id("std.metrics.tests.metric-identity-failures")
fn metric_identity_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if metric_name_alphabet() { 0 } else { 1048576 };
    failed = failed + if metric_name_continuation_alphabet() { 0 } else { 2097152 };
    failed = failed + if metric_name_refuses_per_request_shapes() { 0 } else { 4194304 };
    failed = failed + if metric_name_length_window() { 0 } else { 8388608 };
    failed = failed + if metric_unit_cases() { 0 } else { 16777216 };
    failed = failed + if metric_kind_vocabulary() { 0 } else { 33554432 };
    failed + metric_counter_failures()
}

@id("std.metrics.tests.metric-counter-failures")
fn metric_counter_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if counter_never_decreases() { 0 } else { 67108864 };
    failed = failed + if counter_reset_is_reported_not_hidden() { 0 } else { 134217728 };
    failed = failed + if bucket_count_boundary() { 0 } else { 268435456 };
    failed = failed + if bucket_bounds_are_strictly_increasing() { 0 } else { 536870912 };
    failed = failed + if bucket_selection_is_upper_inclusive() { 0 } else { 1073741824 };
    failed = failed + if cumulative_counts_never_decrease() { 0 } else { 2147483648 };
    failed + metric_budget_failures()
}

@id("std.metrics.tests.metric-budget-failures")
fn metric_budget_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if histogram_totals_are_consistent() { 0 } else { 4294967296 };
    failed = failed + if overflow_aggregation_is_deterministic() { 0 } else { 8589934592 };
    failed = failed + if deployment_budget_boundary() { 0 } else { 17179869184 };
    failed = failed + if metric_admission_is_attributable() { 0 } else { 34359738368 };
    failed
}
