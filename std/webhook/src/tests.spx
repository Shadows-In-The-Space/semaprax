module std.webhook.tests;
use function @id("std.webhook.delivery_admitted") from std.webhook as delivery_admitted;
use function @id("std.webhook.signature_shape_admitted") from std.webhook as signature_shape_admitted;
use function @id("std.webhook.signature_hex_len") from std.webhook as signature_hex_len;
use function @id("std.webhook.byte_is_lower_hex") from std.webhook as byte_is_lower_hex;
use function @id("std.webhook.payload_len_admitted") from std.webhook as payload_len_admitted;
use function @id("std.webhook.timestamp_within_window") from std.webhook as timestamp_within_window;
use function @id("std.webhook.replay_window_seconds") from std.webhook as replay_window_seconds;
use function @id("std.webhook.attempt_admitted") from std.webhook as attempt_admitted;
use function @id("std.webhook.backoff_seconds") from std.webhook as backoff_seconds;

// A full-length signature of all `a` is admitted; one byte short, one byte
// long, one uppercase digit and one non-hex byte are each refused
// individually, so a regression that stops checking any one of those fails
// here rather than hiding behind the others.
@id("std.webhook.tests.signature_shape_cases")
fn signature_shape_cases() -> bool
{
    let mut full = bytes_zeroed(64usize);
    let mut index = 0usize;
    while index < 64usize {
        full = bytes_set(full, index, 97u8);
        index = index + 1usize;
        index < 64usize
    }
    let exact_admitted = signature_shape_admitted(bytes_as_slice(full));
    // An uppercase 'A' at the last position: a scan that stops one byte
    // early passes every other case in this file.
    full = bytes_set(full, 63usize, 65u8);
    let uppercase_refused = !signature_shape_admitted(bytes_as_slice(full));
    full = bytes_set(full, 63usize, 103u8);
    let non_hex_refused = !signature_shape_admitted(bytes_as_slice(full));
    exact_admitted && uppercase_refused && non_hex_refused
}

// Split from the case above rather than sharing its body: this package's
// conformance module is declared arena-bounded, so at most one `Bytes` value
// may be live at a time and a 64-byte and a 63-byte probe cannot coexist.
@id("std.webhook.tests.short_signature_refused")
fn short_signature_refused() -> bool
{
    let mut short = bytes_zeroed(63usize);
    let mut cursor = 0usize;
    while cursor < 63usize {
        short = bytes_set(short, cursor, 97u8);
        cursor = cursor + 1usize;
        cursor < 63usize
    }
    !signature_shape_admitted(bytes_as_slice(short))
}

// The hex alphabet boundary bytes, asserted at the predicate the scanner is
// built from rather than only through it.
@id("std.webhook.tests.hex_alphabet_boundaries")
fn hex_alphabet_boundaries() -> bool
{
    byte_is_lower_hex(48u8) && byte_is_lower_hex(57u8) && byte_is_lower_hex(97u8) && byte_is_lower_hex(102u8) && !byte_is_lower_hex(47u8) && !byte_is_lower_hex(58u8) && !byte_is_lower_hex(96u8) && !byte_is_lower_hex(103u8)
}

// The replay window is symmetric: a timestamp the same distance in the
// future is refused exactly as one in the past. A receiver that clamps only
// the past accepts a clock-skewed forgery indefinitely.
@id("std.webhook.tests.replay_window_is_symmetric")
fn replay_window_is_symmetric() -> bool
{
    let window = replay_window_seconds();
    let past_edge = timestamp_within_window(1000, 1000 + window);
    let past_beyond = !timestamp_within_window(1000, 1000 + window + 1);
    let future_edge = timestamp_within_window(1000 + window, 1000);
    let future_beyond = !timestamp_within_window(1000 + window + 1, 1000);
    past_edge && past_beyond && future_edge && future_beyond
}

// The payload ceiling is inclusive at its limit and refuses one byte more.
@id("std.webhook.tests.payload_budget_boundary")
fn payload_budget_boundary() -> bool
{
    payload_len_admitted(0usize) && payload_len_admitted(65536usize) && !payload_len_admitted(65537usize)
}

// Attempts are counted from 1, so 0 is refused rather than treated as
// "before the first".
@id("std.webhook.tests.attempt_budget_boundary")
fn attempt_budget_boundary() -> bool
{
    !attempt_admitted(0) && attempt_admitted(1) && attempt_admitted(8) && !attempt_admitted(9)
}

// Backoff doubles and then saturates rather than growing without bound, and
// never returns a delay outside its own declared postcondition range.
@id("std.webhook.tests.backoff_doubles_then_saturates")
fn backoff_doubles_then_saturates() -> bool
{
    let first = backoff_seconds(1) == 1;
    let second = backoff_seconds(2) == 2;
    let third = backoff_seconds(3) == 4;
    let seventh = backoff_seconds(7) == 60;
    let eighth = backoff_seconds(8) == 60;
    first && second && third && seventh && eighth
}

// A composed refusal is attributable: each of the three clauses refuses on
// its own while the other two hold.
@id("std.webhook.tests.composed_admission_is_attributable")
fn composed_admission_is_attributable() -> bool
{
    let mut signature = bytes_zeroed(64usize);
    let mut index = 0usize;
    while index < 64usize {
        signature = bytes_set(signature, index, 97u8);
        index = index + 1usize;
        index < 64usize
    }
    let all_hold = delivery_admitted(bytes_as_slice(signature), 1024usize, 1000, 1100);
    let stale_only = !delivery_admitted(bytes_as_slice(signature), 1024usize, 1000, 4600);
    let oversized_only = !delivery_admitted(bytes_as_slice(signature), 65537usize, 1000, 1100);
    signature = bytes_set(signature, 0usize, 122u8);
    let malformed_only = !delivery_admitted(bytes_as_slice(signature), 1024usize, 1000, 1100);
    all_hold && stale_only && oversized_only && malformed_only
}

@id("std.webhook.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if signature_shape_cases() { 0 } else { 1 };
    failed = failed + if short_signature_refused() { 0 } else { 128 };
    failed = failed + if hex_alphabet_boundaries() { 0 } else { 2 };
    failed = failed + if replay_window_is_symmetric() { 0 } else { 4 };
    failed = failed + if payload_budget_boundary() { 0 } else { 8 };
    failed = failed + if attempt_budget_boundary() { 0 } else { 16 };
    failed = failed + if backoff_doubles_then_saturates() { 0 } else { 32 };
    failed = failed + if composed_admission_is_attributable() { 0 } else { 64 };
    failed
}
