module kernel_zero.canonical_int_renderer;

@id("format.negative")
fn negative(value: i64) -> bool
{
    value < 0
}

@id("format.at-least")
fn magnitude_at_least(value: i64, threshold: i64) -> bool
{
    if negative(value) {
        value <= 0 - threshold
    } else {
        value >= threshold
    }
}

@id("format.decimal-digits")
fn decimal_digits(value: i64) -> i64
{
    if magnitude_at_least(value, 1000000000000000000) {
        19
    } else {
        if magnitude_at_least(value, 100000000000000000) {
            18
        } else {
            if magnitude_at_least(value, 10000000000000000) {
                17
            } else {
                if magnitude_at_least(value, 1000000000000000) {
                    16
                } else {
                    if magnitude_at_least(value, 100000000000000) {
                        15
                    } else {
                        if magnitude_at_least(value, 10000000000000) {
                            14
                        } else {
                            if magnitude_at_least(value, 1000000000000) {
                                13
                            } else {
                                if magnitude_at_least(value, 100000000000) {
                                    12
                                } else {
                                    if magnitude_at_least(value, 10000000000) {
                                        11
                                    } else {
                                        if magnitude_at_least(value, 1000000000) {
                                            10
                                        } else {
                                            if magnitude_at_least(value, 100000000) {
                                                9
                                            } else {
                                                if magnitude_at_least(value, 10000000) {
                                                    8
                                                } else {
                                                    if magnitude_at_least(value, 1000000) {
                                                        7
                                                    } else {
                                                        if magnitude_at_least(value, 100000) {
                                                            6
                                                        } else {
                                                            if magnitude_at_least(value, 10000) {
                                                                5
                                                            } else {
                                                                if magnitude_at_least(value, 1000) {
                                                                    4
                                                                } else {
                                                                    if magnitude_at_least(value, 100) {
                                                                        3
                                                                    } else {
                                                                        if magnitude_at_least(value, 10) {
                                                                            2
                                                                        } else {
                                                                            1
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@id("format.power-of-ten")
fn power_of_ten(exponent: i64) -> i64
{
    if exponent == 0 {
        1
    } else {
        if exponent == 1 {
            10
        } else {
            if exponent == 2 {
                100
            } else {
                if exponent == 3 {
                    1000
                } else {
                    if exponent == 4 {
                        10000
                    } else {
                        if exponent == 5 {
                            100000
                        } else {
                            if exponent == 6 {
                                1000000
                            } else {
                                if exponent == 7 {
                                    10000000
                                } else {
                                    if exponent == 8 {
                                        100000000
                                    } else {
                                        if exponent == 9 {
                                            1000000000
                                        } else {
                                            if exponent == 10 {
                                                10000000000
                                            } else {
                                                if exponent == 11 {
                                                    100000000000
                                                } else {
                                                    if exponent == 12 {
                                                        1000000000000
                                                    } else {
                                                        if exponent == 13 {
                                                            10000000000000
                                                        } else {
                                                            if exponent == 14 {
                                                                100000000000000
                                                            } else {
                                                                if exponent == 15 {
                                                                    1000000000000000
                                                                } else {
                                                                    if exponent == 16 {
                                                                        10000000000000000
                                                                    } else {
                                                                        if exponent == 17 {
                                                                            100000000000000000
                                                                        } else {
                                                                            1000000000000000000
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@id("format.decimal-digit")
fn decimal_digit(value: i64, position: i64, digits: i64) -> i64
{
    let divisor = power_of_ten(digits - position - 1);
    let digit = (value / divisor) % 10;
    if digit < 0 {
        0 - digit
    } else {
        digit
    }
}

@id("format.render-length")
fn render_length(value: i64) -> i64
{
    decimal_digits(value) + if negative(value) { 1 } else { 0 }
}

@id("format.render-byte")
fn render_byte(value: i64, index: i64) -> i64
{
    let length = render_length(value);
    if index < 0 || index >= length {
        0
    } else {
        if negative(value) && index == 0 {
            45
        } else {
            let sign = if negative(value) { 1 } else { 0 };
            48 + decimal_digit(value, index - sign, decimal_digits(value))
        }
    }
}

@id("kernel-zero.canonical-int-renderer.main")
fn main() -> i64
{
    render_length(-9223372036854775808)
}
